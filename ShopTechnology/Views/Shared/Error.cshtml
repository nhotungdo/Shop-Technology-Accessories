@{
    ViewData["Title"] = "Lỗi";
}

<div class="error-container">
    <div class="container">
        <div class="error-content">
            <div class="error-icon">
                <i class="fas fa-exclamation-triangle"></i>
            </div>
            
            <h1 class="error-title">Đã xảy ra lỗi</h1>
            <p class="error-message">
                Xin lỗi, đã có lỗi xảy ra trong quá trình xử lý yêu cầu của bạn. 
                Vui lòng thử lại sau hoặc liên hệ với chúng tôi nếu vấn đề vẫn tiếp tục.
            </p>

            <div class="error-actions">
                <a href="/" class="btn btn-primary">
                    <i class="fas fa-home"></i>
                    Về trang chủ
                </a>
                <a href="/Home/Contact" class="btn btn-outline-primary">
                    <i class="fas fa-envelope"></i>
                    Liên hệ hỗ trợ
                </a>
                <button type="button" class="btn btn-outline-secondary" onclick="history.back()">
                    <i class="fas fa-arrow-left"></i>
                    Quay lại
                </button>
            </div>

            <div class="error-help">
                <h3>Bạn có thể thử:</h3>
                <ul>
                    <li>Làm mới trang</li>
                    <li>Kiểm tra kết nối internet</li>
                    <li>Xóa cache trình duyệt</li>
                    <li>Thử trình duyệt khác</li>
                </ul>
            </div>
        </div>
    </div>
</div>
