@{
    ViewData["Title"] = "Thanh toán";
}

<h2 class="mb-4"><i class="fas fa-credit-card text-success"></i> Thanh toán</h2>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">Địa chỉ giao hàng</div>
            <div class="card-body">
                <form asp-action="PlaceOrder" method="post">
                    <div class="mb-3">
                        <label class="form-label">Địa chỉ</label>
                        <textarea name="shippingAddress" class="form-control" rows="4" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Phương thức thanh toán</label>
                        <select name="paymentMethod" class="form-select" required>
                            <option value="COD">COD</option>
                            <option value="VNPay">VNPay</option>
                            <option value="PayPal">PayPal</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-success"><i class="fas fa-check"></i> Xác nhận đặt
                        hàng</button>
                </form>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> Sau khi đặt hàng thành công, bạn có thể theo dõi trạng thái đơn hàng
            trong mục Lịch sử đơn hàng.
        </div>
    </div>
</div>
