@model ShopTechnology.Controllers.RegisterViewModel

@{
    ViewData["Title"] = "Đăng ký";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" />
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h2>Đăng ký tài khoản</h2>
            <p>Tạo tài khoản mới để bắt đầu mua sắm</p>
        </div>

        <div class="auth-body">
            <form asp-action="Register" method="post" class="auth-form">
                <input type="hidden" name="ReturnUrl" value="@ViewData["ReturnUrl"]" />
                
                <div class="form-row">
                    <div class="form-group">
                        <label asp-for="FirstName" class="form-label">Họ</label>
                        <input asp-for="FirstName" type="text" class="form-control" placeholder="Nhập họ" required />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="LastName" class="form-label">Tên</label>
                        <input asp-for="LastName" type="text" class="form-control" placeholder="Nhập tên" required />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="Nhập email của bạn" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password" class="form-label">Mật khẩu</label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Tạo mật khẩu" required />
                    <div class="password-strength">
                        <div class="strength-bar">
                            <div class="strength-fill" id="strengthFill"></div>
                        </div>
                        <span class="strength-text" id="strengthText">Độ mạnh mật khẩu</span>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-control" placeholder="Nhập lại mật khẩu" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <button type="submit" class="btn btn-primary btn-block">Đăng ký</button>
            </form>

            <div class="auth-divider">
                <span>hoặc</span>
            </div>

            <div class="social-auth">
                <button type="button" class="btn btn-google">
                    <i class="fab fa-google"></i>
                    Đăng ký với Google
                </button>
                <button type="button" class="btn btn-facebook">
                    <i class="fab fa-facebook-f"></i>
                    Đăng ký với Facebook
                </button>
            </div>

            <div class="auth-links">
                <p class="login-link">
                    Đã có tài khoản? <a asp-action="Login">Đăng nhập ngay</a>
                </p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Password strength checker
        document.getElementById('Password').addEventListener('input', function() {
            const password = this.value;
            const strengthFill = document.getElementById('strengthFill');
            const strengthText = document.getElementById('strengthText');
            
            let strength = 0;
            let text = '';
            
            if (password.length >= 8) strength++;
            if (password.match(/[a-z]/)) strength++;
            if (password.match(/[A-Z]/)) strength++;
            if (password.match(/[0-9]/)) strength++;
            if (password.match(/[^a-zA-Z0-9]/)) strength++;
            
            switch (strength) {
                case 0:
                case 1:
                    text = 'Rất yếu';
                    strengthFill.style.width = '20%';
                    strengthFill.style.backgroundColor = '#ff4444';
                    break;
                case 2:
                    text = 'Yếu';
                    strengthFill.style.width = '40%';
                    strengthFill.style.backgroundColor = '#ff8800';
                    break;
                case 3:
                    text = 'Trung bình';
                    strengthFill.style.width = '60%';
                    strengthFill.style.backgroundColor = '#ffbb33';
                    break;
                case 4:
                    text = 'Mạnh';
                    strengthFill.style.width = '80%';
                    strengthFill.style.backgroundColor = '#00C851';
                    break;
                case 5:
                    text = 'Rất mạnh';
                    strengthFill.style.width = '100%';
                    strengthFill.style.backgroundColor = '#007E33';
                    break;
            }
            
            strengthText.textContent = text;
        });
    </script>
}
