@model ShopTechnology.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Đăng ký";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Shop Technology Accessories</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/register-modern.css" />
</head>

<body>
    <div class="register-container">
        <!-- Left Panel - Register Form -->
        <div class="register-form-section">
            <div class="logo">
                <div class="logo-icon">
                    <i class="fas fa-user-plus"></i>
                </div>
                <div class="logo-text">ShopTech</div>
            </div>

            <h1 class="welcome-title">Tạo tài khoản mới</h1>
            <p class="welcome-subtitle">Tham gia cùng chúng tôi để trải nghiệm mua sắm tuyệt vời</p>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
                </div>
            }

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <form asp-controller="Account" asp-action="Register" method="post"
                asp-route-returnurl="@ViewData["ReturnUrl"]">
                <div class="form-group">
                    <label asp-for="FullName" class="form-label">Họ tên</label>
                    <input asp-for="FullName" type="text" class="form-input" placeholder="Nhập họ tên của bạn"
                        required />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-input" placeholder="example@gmail.com" required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PhoneNumber" class="form-label">Số điện thoại</label>
                    <input asp-for="PhoneNumber" type="tel" class="form-input" placeholder="0123456789" />
                    <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password" class="form-label">Mật khẩu</label>
                    <input asp-for="Password" type="password" class="form-input" placeholder="••••••••" required />
                    <small class="form-text text-muted">
                        Mật khẩu phải có ít nhất 8 ký tự, bao gồm chữ hoa, chữ thường, số và ký tự đặc biệt
                    </small>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="form-label">Xác nhận mật khẩu</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-input" placeholder="••••••••"
                        required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="register-button">
                    <span class="button-text">
                        <i class="fas fa-user-plus"></i> Đăng ký
                    </span>
                    <span class="loading">
                        <i class="fas fa-spinner spinner"></i> Đang đăng ký...
                    </span>
                </button>
            </form>

            <div class="login-link">
                Đã có tài khoản? <a href="/Account/Login">Đăng nhập ngay</a>
            </div>
        </div>

        <!-- Right Panel - Illustration -->
        <div class="illustration-section">
            <div class="clouds">
                <div class="cloud"></div>
                <div class="cloud"></div>
                <div class="cloud"></div>
            </div>

            <div class="illustration-content">
                <div class="character">
                    <div class="character-body">
                        <div class="character-head"></div>
                        <div class="character-arm"></div>
                        <div class="smartphone">
                            <div class="phone-screen">
                                <div class="user-icon">
                                    <i class="fas fa-user-plus"></i>
                                </div>
                                <div class="progress-bar">
                                    <div class="progress-fill"></div>
                                </div>
                                <div style="font-size: 6px; text-align: center;">
                                    Join us today<br>for amazing shopping
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="success-bubble">
                        <i class="fas fa-check"></i>
                    </div>
                    <div class="security-lock">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('form');
            const button = document.querySelector('.register-button');
            const buttonText = document.querySelector('.button-text');
            const loading = document.querySelector('.loading');

            if (form) {
                form.addEventListener('submit', function () {
                    button.disabled = true;
                    buttonText.style.display = 'none';
                    loading.classList.add('show');
                });
            }
        });
    </script>
</body>

</html>
