@model ShopTechnology.DTOs.ResetPasswordDTO

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Shop Technology Accessories</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/reset-password.css" />
</head>

<body>
    <div class="reset-container">
        <!-- Left Panel - Reset Password Form -->
        <div class="reset-form-section">
            <div class="logo">
                <div class="logo-icon">
                    <i class="fas fa-laptop"></i>
                </div>
                <div class="logo-text">ShopTech</div>
            </div>

            <h1 class="welcome-title">Reset Password</h1>
            <p class="welcome-subtitle">Enter your new password below</p>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
                </div>
            }

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    <div asp-validation-summary="All"></div>
                </div>
            }

            <form asp-controller="Account" asp-action="ResetPassword" method="post">
                <input asp-for="Token" type="hidden" />
                <input asp-for="Email" type="hidden" />

                <div class="form-group">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-input" value="@Model.Email" readonly />
                </div>

                <div class="form-group">
                    <label asp-for="NewPassword" class="form-label">New Password</label>
                    <input asp-for="NewPassword" type="password" class="form-input" placeholder="Enter new password"
                        required />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="form-label">Confirm New Password</label>
                    <input asp-for="ConfirmPassword" type="password" class="form-input"
                        placeholder="Confirm new password" required />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="reset-button">
                    <span class="button-text">
                        <i class="fas fa-key"></i> Reset Password
                    </span>
                    <span class="loading">
                        <i class="fas fa-spinner spinner"></i> Resetting password...
                    </span>
                </button>
            </form>

            <div class="back-link">
                <a asp-controller="Account" asp-action="Login">
                    <i class="fas fa-arrow-left"></i> Back to Sign In
                </a>
            </div>
        </div>

        <!-- Right Panel - Illustration -->
        <div class="illustration-section">
            <div class="clouds">
                <div class="cloud"></div>
                <div class="cloud"></div>
                <div class="cloud"></div>
            </div>

            <div class="illustration-content">
                <div class="character">
                    <div class="character-body">
                        <div class="character-head"></div>
                        <div class="character-arm"></div>
                        <div class="smartphone">
                            <div class="phone-screen">
                                <div class="key-icon">
                                    <i class="fas fa-key"></i>
                                </div>
                                <div class="progress-bar">
                                    <div class="progress-fill"></div>
                                </div>
                                <div style="font-size: 6px; text-align: center;">
                                    Resetting<br>password
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="success-bubble">
                        <i class="fas fa-check"></i>
                    </div>
                    <div class="security-lock">
                        <i class="fas fa-lock"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('form');
            const button = document.querySelector('.reset-button');
            const buttonText = document.querySelector('.button-text');
            const loading = document.querySelector('.loading');

            if (form) {
                form.addEventListener('submit', function () {
                    button.disabled = true;
                    buttonText.style.display = 'none';
                    loading.classList.add('show');
                });
            }

            // Password confirmation validation
            const newPasswordInput = document.querySelector('input[name="NewPassword"]');
            const confirmPasswordInput = document.querySelector('input[name="ConfirmPassword"]');

            if (newPasswordInput && confirmPasswordInput) {
                confirmPasswordInput.addEventListener('input', function () {
                    if (this.value !== newPasswordInput.value) {
                        this.setCustomValidity('Passwords do not match');
                    } else {
                        this.setCustomValidity('');
                    }
                });
            }
        });
    </script>
</body>

</html>
