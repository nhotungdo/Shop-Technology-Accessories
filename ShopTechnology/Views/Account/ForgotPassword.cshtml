@model ShopTechnology.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Quên mật khẩu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth.css" />
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h2>Quên mật khẩu</h2>
            <p>Nhập email để nhận link đặt lại mật khẩu</p>
        </div>

        <div class="auth-body">
            <form asp-action="ForgotPassword" method="post" class="auth-form">
                <div class="form-group">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="Nhập email của bạn"
                        required />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <button type="submit" class="btn btn-primary btn-block">Gửi link đặt lại mật khẩu</button>
            </form>

            <div class="auth-links">
                <a asp-action="Login" class="back-to-login">
                    <i class="fas fa-arrow-left"></i>
                    Quay lại đăng nhập
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
