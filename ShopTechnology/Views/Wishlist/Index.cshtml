@{
    ViewData["Title"] = "Danh sách yêu thích";
}

@section Styles {
    <link rel="stylesheet" href="~/css/wishlist.css" />
}

<div class="wishlist-header">
    <div class="container">
        <h1>Danh sách yêu thích</h1>
        <p>Quản lý sản phẩm bạn yêu thích</p>
    </div>
</div>

<div class="wishlist-container">
    <div class="container">
        <div class="wishlist-content">
            <div class="wishlist-actions">
                <button type="button" class="btn btn-outline-primary">
                    <i class="fas fa-share"></i>
                    Chia sẻ
                </button>
                <button type="button" class="btn btn-outline-danger">
                    <i class="fas fa-trash"></i>
                    Xóa tất cả
                </button>
            </div>

            <div class="wishlist-grid">
                <div class="wishlist-item">
                    <div class="product-image">
                        <img src="/img/placeholder.jpg" alt="Sản phẩm" />
                        <button type="button" class="remove-btn">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    
                    <div class="product-info">
                        <h3 class="product-name">iPhone 15 Pro Max</h3>
                        <div class="product-rating">
                            <div class="stars">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="far fa-star"></i>
                            </div>
                            <span>(15 đánh giá)</span>
                        </div>
                        
                        <div class="product-price">
                            <span class="current-price">25,000,000 ₫</span>
                            <span class="original-price">28,000,000 ₫</span>
                        </div>
                        
                        <div class="product-actions">
                            <button type="button" class="btn btn-primary">
                                <i class="fas fa-shopping-cart"></i>
                                Thêm vào giỏ
                            </button>
                        </div>
                    </div>
                </div>

                <div class="wishlist-item">
                    <div class="product-image">
                        <img src="/img/placeholder.jpg" alt="Sản phẩm" />
                        <button type="button" class="remove-btn">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    
                    <div class="product-info">
                        <h3 class="product-name">MacBook Pro M3</h3>
                        <div class="product-rating">
                            <div class="stars">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                            </div>
                            <span>(8 đánh giá)</span>
                        </div>
                        
                        <div class="product-price">
                            <span class="current-price">45,000,000 ₫</span>
                        </div>
                        
                        <div class="product-actions">
                            <button type="button" class="btn btn-primary">
                                <i class="fas fa-shopping-cart"></i>
                                Thêm vào giỏ
                            </button>
                        </div>
                    </div>
                </div>

                <div class="wishlist-item">
                    <div class="product-image">
                        <img src="/img/placeholder.jpg" alt="Sản phẩm" />
                        <button type="button" class="remove-btn">
                            <i class="fas fa-times"></i>
                        </button>
                    </div>
                    
                    <div class="product-info">
                        <h3 class="product-name">AirPods Pro 2</h3>
                        <div class="product-rating">
                            <div class="stars">
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="fas fa-star"></i>
                                <i class="far fa-star"></i>
                            </div>
                            <span>(22 đánh giá)</span>
                        </div>
                        
                        <div class="product-price">
                            <span class="current-price">5,500,000 ₫</span>
                            <span class="original-price">6,000,000 ₫</span>
                        </div>
                        
                        <div class="product-actions">
                            <button type="button" class="btn btn-primary">
                                <i class="fas fa-shopping-cart"></i>
                                Thêm vào giỏ
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="wishlist-empty" style="display: none;">
                <div class="empty-icon">
                    <i class="far fa-heart"></i>
                </div>
                <h3>Danh sách yêu thích trống</h3>
                <p>Bạn chưa có sản phẩm nào trong danh sách yêu thích</p>
                <a href="/Product" class="btn btn-primary">
                    <i class="fas fa-shopping-bag"></i>
                    Bắt đầu mua sắm
                </a>
            </div>
        </div>
    </div>
</div>
