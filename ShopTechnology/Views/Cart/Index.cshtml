@model ShopTechnology.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="container">
    <h2 class="mb-4">
        <i class="fas fa-shopping-cart text-primary"></i> Giỏ hàng của bạn
    </h2>

    @if (Model.Items.Any())
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Sản phẩm (@Model.Items.Count)</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var item in Model.Items)
                        {
                            <div class="row mb-3 cart-item" data-cart-item-id="@item.CartItemId">
                                <div class="col-md-2">
                                    <img src="@(string.IsNullOrEmpty(item.ProductImage) ? "/img/no-image.png" : item.ProductImage)"
                                        class="img-fluid rounded" alt="@item.ProductName"
                                        style="height: 80px; object-fit: cover;">
                                </div>
                                <div class="col-md-4">
                                    <h6 class="mb-1">@item.ProductName</h6>
                                    <p class="text-muted mb-0">Thương hiệu: @item.ProductBrand</p>
                                    <p class="text-muted mb-0">SKU: @item.ProductSKU</p>
                                </div>
                                <div class="col-md-3">
                                    <div class="input-group">
                                        <button class="btn btn-outline-secondary decrease-quantity" type="button">-</button>
                                        <input type="number" class="form-control text-center quantity-input"
                                            value="@item.Quantity" min="1" max="@item.StockQuantity">
                                        <button class="btn btn-outline-secondary increase-quantity" type="button">+</button>
                                    </div>
                                    <small class="text-muted">Còn lại: @item.StockQuantity</small>
                                </div>
                                <div class="col-md-2">
                                    <p class="fw-bold text-primary">@item.TotalPrice.ToString("N0") VNĐ</p>
                                    <small class="text-muted">@item.UnitPrice.ToString("N0") VNĐ/chiếc</small>
                                </div>
                                <div class="col-md-1">
                                    <button class="btn btn-outline-danger btn-sm remove-item"
                                        data-cart-item-id="@item.CartItemId">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Tổng đơn hàng</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tạm tính:</span>
                            <span>@Model.SubTotal.ToString("N0") VNĐ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Thuế (10%):</span>
                            <span>@Model.TaxAmount.ToString("N0") VNĐ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Phí vận chuyển:</span>
                            <span>@Model.ShippingFee.ToString("N0") VNĐ</span>
                        </div>
                        @if (Model.DiscountAmount > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 text-success">
                                <span>Giảm giá:</span>
                                <span>-@Model.DiscountAmount.ToString("N0") VNĐ</span>
                            </div>
                        }
                        <hr>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="fw-bold">Tổng tiền:</span>
                            <span class="fw-bold text-primary fs-5">@Model.TotalAmount.ToString("N0") VNĐ</span>
                        </div>

                        <!-- Mã khuyến mãi -->
                        <div class="mb-3">
                            <div class="input-group">
                                <input type="text" class="form-control" id="promotionCode" placeholder="Nhập mã khuyến mãi">
                                <button class="btn btn-outline-primary" type="button" id="applyPromotion">Áp dụng</button>
                            </div>
                            <small class="text-muted">Nhập mã khuyến mãi để được giảm giá</small>
                        </div>

                        <div class="d-grid gap-2">
                            <a asp-controller="Checkout" asp-action="Index" class="btn btn-success">
                                <i class="fas fa-credit-card"></i> Thanh toán
                            </a>
                            <button class="btn btn-outline-danger clear-cart">
                                <i class="fas fa-trash"></i> Xóa tất cả
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
            <h4 class="text-muted">Giỏ hàng trống</h4>
            <p class="text-muted">Bạn chưa có sản phẩm nào trong giỏ hàng</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                <i class="fas fa-shopping-bag"></i> Mua sắm ngay
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Tăng số lượng
            $('.increase-quantity').click(function () {
                var input = $(this).siblings('.quantity-input');
                var currentValue = parseInt(input.val());
                var maxValue = parseInt(input.attr('max'));
                if (currentValue < maxValue) {
                    input.val(currentValue + 1);
                    updateQuantity($(this).closest('.cart-item'));
                }
            });

            // Giảm số lượng
            $('.decrease-quantity').click(function () {
                var input = $(this).siblings('.quantity-input');
                var currentValue = parseInt(input.val());
                if (currentValue > 1) {
                    input.val(currentValue - 1);
                    updateQuantity($(this).closest('.cart-item'));
                }
            });

            // Thay đổi số lượng bằng input
            $('.quantity-input').change(function () {
                updateQuantity($(this).closest('.cart-item'));
            });

            // Xóa sản phẩm
            $('.remove-item').click(function () {
                var cartItemId = $(this).data('cart-item-id');
                if (confirm('Bạn có chắc muốn xóa sản phẩm này khỏi giỏ hàng?')) {
                    removeFromCart(cartItemId);
                }
            });

            // Xóa tất cả
            $('.clear-cart').click(function () {
                if (confirm('Bạn có chắc muốn xóa tất cả sản phẩm khỏi giỏ hàng?')) {
                    clearCart();
                }
            });

            // Áp dụng mã khuyến mãi
            $('#applyPromotion').click(function () {
                var code = $('#promotionCode').val();
                if (code.trim() !== '') {
                    applyPromotion(code);
                }
            });

            function updateQuantity(cartItem) {
                var cartItemId = cartItem.find('.remove-item').data('cart-item-id');
                var quantity = cartItem.find('.quantity-input').val();

                $.post('/Cart/UpdateQuantity', {
                    cartItemId: cartItemId,
                    quantity: quantity
                })
                    .done(function (response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert(response.message);
                        }
                    })
                    .fail(function () {
                        alert('Có lỗi xảy ra khi cập nhật số lượng');
                    });
            }

            function removeFromCart(cartItemId) {
                $.post('/Cart/RemoveFromCart', {
                    cartItemId: cartItemId
                })
                    .done(function (response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert(response.message);
                        }
                    })
                    .fail(function () {
                        alert('Có lỗi xảy ra khi xóa sản phẩm');
                    });
            }

            function clearCart() {
                $.post('/Cart/ClearCart')
                    .done(function (response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert(response.message);
                        }
                    })
                    .fail(function () {
                        alert('Có lỗi xảy ra khi xóa giỏ hàng');
                    });
            }

            function applyPromotion(code) {
                $.post('/Cart/ApplyPromotion', {
                    promotionCode: code
                })
                    .done(function (response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert(response.message);
                        }
                    })
                    .fail(function () {
                        alert('Có lỗi xảy ra khi áp dụng mã khuyến mãi');
                    });
            }
        });
    </script>
}
