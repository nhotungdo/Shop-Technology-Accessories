@model CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng";
}

<div class="container">
    <h2 class="mb-4">
        <i class="fas fa-shopping-cart text-primary"></i> Giỏ hàng của bạn
    </h2>

    @if (Model.Items.Any())
    {
        <div class="row">
            <div class="col-md-8">
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">Sản phẩm (@Model.TotalItems)</h5>
                    </div>
                    <div class="card-body">
                        @foreach (var item in Model.Items)
                        {
                            <div class="row mb-3 cart-item" data-cart-item-id="@item.CartItemId">
                                <div class="col-md-2">
                                    <img src="@item.ProductImage" class="img-fluid rounded" alt="@item.ProductName" style="height: 80px; object-fit: cover;">
                                </div>
                                <div class="col-md-4">
                                    <h6 class="mb-1">@item.ProductName</h6>
                                    <p class="text-muted mb-0">Đơn giá: @item.Price.ToString("N0") VNĐ</p>
                                </div>
                                <div class="col-md-3">
                                    <div class="input-group">
                                        <button class="btn btn-outline-secondary decrease-quantity" type="button">-</button>
                                        <input type="number" class="form-control text-center quantity-input" value="@item.Quantity" min="1" max="@item.StockQuantity">
                                        <button class="btn btn-outline-secondary increase-quantity" type="button">+</button>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <p class="fw-bold text-primary">@item.TotalPrice.ToString("N0") VNĐ</p>
                                </div>
                                <div class="col-md-1">
                                    <button class="btn btn-outline-danger btn-sm remove-item">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0">Tổng đơn hàng</h5>
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tổng sản phẩm:</span>
                            <span>@Model.TotalItems</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="fw-bold">Tổng tiền:</span>
                            <span class="fw-bold text-primary fs-5">@Model.TotalAmount.ToString("N0") VNĐ</span>
                        </div>
                        <div class="d-grid gap-2">
                            <a asp-controller="Order" asp-action="Checkout" class="btn btn-success">
                                <i class="fas fa-credit-card"></i> Thanh toán
                            </a>
                            <button class="btn btn-outline-danger clear-cart">
                                <i class="fas fa-trash"></i> Xóa tất cả
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-shopping-cart fa-3x text-muted mb-3"></i>
            <h4 class="text-muted">Giỏ hàng trống</h4>
            <p class="text-muted">Bạn chưa có sản phẩm nào trong giỏ hàng</p>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary">
                <i class="fas fa-shopping-bag"></i> Mua sắm ngay
            </a>
        </div>
    }
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Tăng số lượng
            $('.increase-quantity').click(function() {
                var input = $(this).siblings('.quantity-input');
                var currentValue = parseInt(input.val());
                var maxValue = parseInt(input.attr('max'));
                if (currentValue < maxValue) {
                    input.val(currentValue + 1);
                    updateQuantity(input);
                }
            });

            // Giảm số lượng
            $('.decrease-quantity').click(function() {
                var input = $(this).siblings('.quantity-input');
                var currentValue = parseInt(input.val());
                if (currentValue > 1) {
                    input.val(currentValue - 1);
                    updateQuantity(input);
                }
            });

            // Thay đổi số lượng bằng input
            $('.quantity-input').change(function() {
                updateQuantity($(this));
            });

            // Xóa sản phẩm
            $('.remove-item').click(function() {
                var cartItem = $(this).closest('.cart-item');
                var cartItemId = cartItem.data('cart-item-id');
                
                if (confirm('Bạn có chắc muốn xóa sản phẩm này?')) {
                    $.post('/Cart/RemoveFromCart', { cartItemId: cartItemId })
                        .done(function(response) {
                            if (response.success) {
                                cartItem.remove();
                                updateCartSummary(response.totalAmount, response.totalItems);
                                if (response.totalItems === 0) {
                                    location.reload();
                                }
                            } else {
                                alert('Có lỗi xảy ra: ' + response.message);
                            }
                        })
                        .fail(function() {
                            alert('Có lỗi xảy ra khi xóa sản phẩm');
                        });
                }
            });

            // Xóa tất cả
            $('.clear-cart').click(function() {
                if (confirm('Bạn có chắc muốn xóa tất cả sản phẩm trong giỏ hàng?')) {
                    $.post('/Cart/ClearCart')
                        .done(function(response) {
                            if (response.success) {
                                location.reload();
                            } else {
                                alert('Có lỗi xảy ra: ' + response.message);
                            }
                        })
                        .fail(function() {
                            alert('Có lỗi xảy ra khi xóa giỏ hàng');
                        });
                }
            });

            function updateQuantity(input) {
                var cartItem = input.closest('.cart-item');
                var cartItemId = cartItem.data('cart-item-id');
                var quantity = parseInt(input.val());
                
                $.post('/Cart/UpdateQuantity', { cartItemId: cartItemId, quantity: quantity })
                    .done(function(response) {
                        if (response.success) {
                            updateCartSummary(response.totalAmount, response.totalItems);
                            // Cập nhật tổng tiền của sản phẩm
                            var price = parseFloat(cartItem.find('.text-primary').text().replace(/[^\d]/g, ''));
                            var totalPrice = price * quantity;
                            cartItem.find('.text-primary').text(totalPrice.toLocaleString() + ' VNĐ');
                        } else {
                            alert('Có lỗi xảy ra: ' + response.message);
                        }
                    })
                    .fail(function() {
                        alert('Có lỗi xảy ra khi cập nhật số lượng');
                    });
            }

            function updateCartSummary(totalAmount, totalItems) {
                $('.card-body .d-flex:first span:last').text(totalItems);
                $('.card-body .d-flex:last span:last').text(totalAmount.toLocaleString() + ' VNĐ');
            }
        });
    </script>
}
