@model ShopTechnology.ViewModels.PaymentViewModel
@{
    ViewData["Title"] = "Thanh toán đơn hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row">
        <!-- Thông tin đơn hàng -->
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-shopping-cart me-2"></i>
                        Thông tin đơn hàng #@Model.Order.OrderNumber
                    </h5>
                </div>
                <div class="card-body">
                    <!-- Thông tin giao hàng -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <h6 class="text-primary mb-3">
                                <i class="fas fa-shipping-fast me-2"></i>
                                Thông tin giao hàng
                            </h6>
                            <div class="row">
                                <div class="col-md-6">
                                    <p><strong>Họ tên:</strong> @Model.Order.CustomerName</p>
                                    <p><strong>Email:</strong> @Model.Order.CustomerEmail</p>
                                    <p><strong>Số điện thoại:</strong> @Model.Order.CustomerPhone</p>
                                </div>
                                <div class="col-md-6">
                                    <p><strong>Địa chỉ:</strong> @Model.Order.ShippingAddress</p>
                                    @if (!string.IsNullOrEmpty(Model.Order.ShippingCity))
                                    {
                                        <p><strong>Thành phố:</strong> @Model.Order.ShippingCity</p>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.Order.ShippingProvince))
                                    {
                                        <p><strong>Tỉnh:</strong> @Model.Order.ShippingProvince</p>
                                    }
                                    @if (!string.IsNullOrEmpty(Model.Order.ShippingPostalCode))
                                    {
                                        <p><strong>Mã bưu điện:</strong> @Model.Order.ShippingPostalCode</p>
                                    }
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Order.OrderNotes))
                            {
                                <p><strong>Ghi chú:</strong> @Model.Order.OrderNotes</p>
                            }
                        </div>
                    </div>

                    <!-- Danh sách sản phẩm -->
                    <div class="row mb-4">
                        <div class="col-12">
                            <h6 class="text-primary mb-3">
                                <i class="fas fa-box me-2"></i>
                                Sản phẩm đã đặt
                            </h6>
                            @foreach (var item in Model.Order.OrderDetails)
                            {
                                <div class="d-flex align-items-center border-bottom py-2">
                                    <div class="flex-shrink-0">
                                        @if (!string.IsNullOrEmpty(item.ProductImage))
                                        {
                                            <img src="@item.ProductImage" alt="@item.ProductName" class="img-thumbnail" style="width: 60px; height: 60px; object-fit: cover;">
                                        }
                                        else
                                        {
                                            <div class="bg-light d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                                                <i class="fas fa-image text-muted"></i>
                                            </div>
                                        }
                                    </div>
                                    <div class="flex-grow-1 ms-3">
                                        <h6 class="mb-1">@item.ProductName</h6>
                                        @if (!string.IsNullOrEmpty(item.ProductBrand))
                                        {
                                            <small class="text-muted">@item.ProductBrand</small>
                                        }
                                    </div>
                                    <div class="text-end">
                                        <div class="fw-bold">@item.Quantity x @item.UnitPrice.ToString("N0") đ</div>
                                        <div class="text-primary fw-bold">@item.TotalPrice.ToString("N0") đ</div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Form thanh toán -->
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="fas fa-credit-card me-2"></i>
                        Thanh toán
                    </h5>
                </div>
                <div class="card-body">
                    <!-- Tổng tiền -->
                    <div class="mb-4">
                        <div class="d-flex justify-content-between mb-2">
                            <span>Tạm tính:</span>
                            <span>@Model.Order.SubTotal.ToString("N0") đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Thuế:</span>
                            <span>@Model.Order.TaxAmount.ToString("N0") đ</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span>Phí vận chuyển:</span>
                            <span>@Model.Order.ShippingFee.ToString("N0") đ</span>
                        </div>
                        @if (Model.Order.DiscountAmount > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 text-success">
                                <span>Giảm giá:</span>
                                <span>-@Model.Order.DiscountAmount.ToString("N0") đ</span>
                            </div>
                        }
                        <hr>
                        <div class="d-flex justify-content-between fw-bold fs-5">
                            <span>Tổng cộng:</span>
                            <span class="text-primary">@Model.Order.TotalAmount.ToString("N0") đ</span>
                        </div>
                    </div>

                    <!-- Phương thức thanh toán -->
                    <form asp-action="ProcessPayment" method="post">
                        <input type="hidden" name="orderId" value="@Model.Order.OrderId" />
                        
                        <div class="mb-3">
                            <label class="form-label fw-bold">Chọn phương thức thanh toán:</label>
                            
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="paymentMethod" id="cod" value="COD" checked>
                                <label class="form-check-label" for="cod">
                                    <i class="fas fa-money-bill-wave text-success me-2"></i>
                                    Thanh toán khi nhận hàng (COD)
                                </label>
                            </div>
                            
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="paymentMethod" id="bank" value="BankTransfer">
                                <label class="form-check-label" for="bank">
                                    <i class="fas fa-university text-primary me-2"></i>
                                    Chuyển khoản ngân hàng
                                </label>
                            </div>
                            
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="paymentMethod" id="momo" value="MoMo">
                                <label class="form-check-label" for="momo">
                                    <i class="fas fa-mobile-alt text-danger me-2"></i>
                                    Ví MoMo
                                </label>
                            </div>
                            
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="paymentMethod" id="vnpay" value="VNPay">
                                <label class="form-check-label" for="vnpay">
                                    <i class="fas fa-credit-card text-warning me-2"></i>
                                    VNPay
                                </label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success w-100 btn-lg">
                            <i class="fas fa-lock me-2"></i>
                            Xác nhận thanh toán
                        </button>
                    </form>

                    <div class="mt-3 text-center">
                        <small class="text-muted">
                            <i class="fas fa-shield-alt me-1"></i>
                            Thông tin thanh toán của bạn được bảo mật
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Hiển thị thông tin thanh toán tương ứng với phương thức được chọn
            $('input[name="paymentMethod"]').change(function() {
                var method = $(this).val();
                // Có thể thêm logic hiển thị thông tin thanh toán tương ứng ở đây
            });
        });
    </script>
}
