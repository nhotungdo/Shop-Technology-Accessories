@model ShopTechnology.Models.Product
@using ShopTechnology.Models

@{
    ViewData["Title"] = Model.Name;
    var relatedProducts = ViewBag.RelatedProducts as List<ShopTechnology.Models.Product>;
}

@section Styles {
    <link rel="stylesheet" href="~/css/product.css" />
}

<div class="product-detail-container">
    <div class="container">
        <!-- Breadcrumb -->
        <nav class="breadcrumb-nav">
            <ol class="breadcrumb">
                <li class="breadcrumb-item">
                    <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                </li>
                <li class="breadcrumb-item">
                    <a asp-controller="Product" asp-action="Index">Sản phẩm</a>
                </li>
                @if (Model.Category != null)
                {
                    <li class="breadcrumb-item">
                        <a asp-controller="Product" asp-action="Category"
                            asp-route-id="@Model.Category.CategoryId">@Model.Category.Name</a>
                    </li>
                }
                <li class="breadcrumb-item active">@Model.Name</li>
            </ol>
        </nav>

        <div class="product-detail-content">
            <!-- Product Gallery -->
            <div class="product-gallery">
                <div class="main-image">
                    <img id="mainImage"
                        src="@(Model.ProductImages?.FirstOrDefault(img => img.IsMain)?.ImageUrl ?? "/img/placeholder.jpg")"
                        alt="@Model.Name" />
                </div>

                @if (Model.ProductImages != null && Model.ProductImages.Any())
                {
                    <div class="thumbnail-images">
                        @foreach (var image in Model.ProductImages.OrderBy(img => img.DisplayOrder))
                        {
                            <div class="thumbnail @(image.IsMain ? "active" : "")" onclick="changeMainImage('@image.ImageUrl')">
                                <img src="@image.ImageUrl" alt="@Model.Name" />
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Product Info -->
            <div class="product-info">
                <div class="product-header">
                    <h1 class="product-title">@Model.Name</h1>

                    <div class="product-badges">
                        @if (Model.IsNew)
                        {
                            <span class="product-badge badge-new">Mới</span>
                        }
                        @if (Model.IsHot)
                        {
                            <span class="product-badge badge-hot">Hot</span>
                        }
                        @if (Model.Price < 1000000)
                        {
                            <span class="product-badge badge-sale">Sale</span>
                        }
                    </div>
                </div>

                <div class="product-rating">
                    <div class="stars">
                        @{
                            var reviews = Model.Reviews?.ToList() ?? new List<Review>();
                            var avgRating = reviews.Any() ? reviews.Average(r => r.Rating) : 0;
                            var reviewCount = reviews.Count;
                        }
                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= avgRating)
                            {
                                <i class="fas fa-star"></i>
                            }
                            else
                            {
                                <i class="far fa-star"></i>
                            }
                        }
                    </div>
                    <span class="rating-text">@avgRating.ToString("F1") (@reviewCount đánh giá)</span>
                    <a href="#reviews" class="review-link">Xem tất cả đánh giá</a>
                </div>

                <div class="product-price">
                    <span class="current-price">@Model.Price.ToString("N0") ₫</span>
                    @* CompareAtPrice not available in new model *@
                </div>

                <div class="product-description">
                    <p>@Model.Description</p>
                </div>

                <div class="product-options">
                    <div class="quantity-selector">
                        <label>Số lượng:</label>
                        <div class="quantity-controls">
                            <button type="button" class="quantity-btn" onclick="decreaseQuantity()">-</button>
                            <input type="number" id="quantity" value="1" min="1" max="@Model.StockQuantity"
                                class="quantity-input" />
                            <button type="button" class="quantity-btn" onclick="increaseQuantity()">+</button>
                        </div>
                        <span class="stock-info">Còn @Model.StockQuantity sản phẩm</span>
                    </div>

                    <div class="product-actions">
                        <button type="button" class="btn btn-primary btn-lg btn-add-cart"
                            onclick="addToCart(@Model.ProductId)">
                            <i class="fas fa-shopping-cart"></i>
                            Thêm vào giỏ hàng
                        </button>
                        <button type="button" class="btn btn-outline-primary btn-lg"
                            onclick="addToWishlist(@Model.ProductId)">
                            <i class="far fa-heart"></i>
                            Yêu thích
                        </button>
                    </div>
                </div>

                <div class="product-meta">
                    <div class="meta-item">
                        <span class="meta-label">SKU:</span>
                        <span class="meta-value">@Model.SKU</span>
                    </div>
                    <div class="meta-item">
                        <span class="meta-label">Danh mục:</span>
                        <span class="meta-value">@(Model.Category?.Name ?? "Không phân loại")</span>
                    </div>
                    <div class="meta-item">
                        <span class="meta-label">Tình trạng:</span>
                        <span class="meta-value @(Model.StockQuantity > 0 ? "in-stock" : "out-of-stock")">
                            @(Model.StockQuantity > 0 ? "Còn hàng" : "Hết hàng")
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Product Tabs -->
        <div class="product-tabs">
            <div class="tab-navigation">
                <button type="button" class="tab-btn active" data-tab="description">Mô tả</button>
                <button type="button" class="tab-btn" data-tab="specifications">Thông số kỹ thuật</button>
                <button type="button" class="tab-btn" data-tab="reviews">Đánh giá (@reviewCount)</button>
            </div>

            <div class="tab-content">
                <!-- Description Tab -->
                <div class="tab-pane active" id="description">
                    <div class="description-content">
                        @Html.Raw(Model.Description)
                    </div>
                </div>

                <!-- Specifications Tab -->
                <div class="tab-pane" id="specifications">
                    <div class="specifications-content">
                        <p>Chưa có thông số kỹ thuật cho sản phẩm này.</p>
                    </div>
                </div>

                <!-- Reviews Tab -->
                <div class="tab-pane" id="reviews">
                    <div class="reviews-content">
                        <div class="reviews-header">
                            <h3>Đánh giá sản phẩm</h3>
                            <button type="button" class="btn btn-primary" onclick="showReviewForm()">
                                <i class="fas fa-plus"></i>
                                Viết đánh giá
                            </button>
                        </div>

                        @if (Model.Reviews != null && Model.Reviews.Any())
                        {
                            <div class="reviews-list">
                                @foreach (var review in Model.Reviews.OrderByDescending(r => r.CreatedAt))
                                {
                                    <div class="review-item">
                                        <div class="review-header">
                                            <div class="reviewer-info">
                                                <span class="reviewer-name">@review.User?.FullName</span>
                                                <div class="review-rating">
                                                    @for (int i = 1; i <= 5; i++)
                                                    {
                                                        if (i <= review.Rating)
                                                        {
                                                            <i class="fas fa-star"></i>
                                                        }
                                                        else
                                                        {
                                                            <i class="far fa-star"></i>
                                                        }
                                                    }
                                                </div>
                                            </div>
                                            <span class="review-date">@review.CreatedAt.ToString("dd/MM/yyyy")</span>
                                        </div>

                                        <div class="review-content">
                                            <h4 class="review-title">@review.Title</h4>
                                            <p class="review-text">@review.Comment</p>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="no-reviews">
                                <p>Chưa có đánh giá nào cho sản phẩm này.</p>
                                <p>Hãy là người đầu tiên đánh giá!</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Related Products -->
        @if (relatedProducts != null && relatedProducts.Any())
        {
            <div class="related-products">
                <h3>Sản phẩm liên quan</h3>
                <div class="related-products-grid">
                    @foreach (var product in relatedProducts.Take(4))
                    {
                        <div class="related-product-card">
                            <div class="product-image">
                                <img src="@(product.ProductImages?.FirstOrDefault(img => img.IsMain)?.ImageUrl ?? "/img/placeholder.jpg")"
                                    alt="@product.Name" />
                            </div>
                            <div class="product-content">
                                <h4 class="product-name">
                                    <a asp-action="Details" asp-route-id="@product.ProductId">@product.Name</a>
                                </h4>
                                <div class="product-price">
                                    <span class="current-price">@product.Price.ToString("N0") ₫</span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Tab functionality
        document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const tabId = this.dataset.tab;

                // Remove active class from all tabs and panes
                document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
                document.querySelectorAll('.tab-pane').forEach(p => p.classList.remove('active'));

                // Add active class to current tab and pane
                this.classList.add('active');
                document.getElementById(tabId).classList.add('active');
            });
        });

        // Image gallery
        function changeMainImage(imageUrl) {
            document.getElementById('mainImage').src = imageUrl;

            // Update active thumbnail
            document.querySelectorAll('.thumbnail').forEach(thumb => thumb.classList.remove('active'));
            event.target.closest('.thumbnail').classList.add('active');
        }

        // Quantity controls
        function decreaseQuantity() {
            const input = document.getElementById('quantity');
            const currentValue = parseInt(input.value);
            if (currentValue > 1) {
                input.value = currentValue - 1;
            }
        }

        function increaseQuantity() {
            const input = document.getElementById('quantity');
            const currentValue = parseInt(input.value);
            const maxValue = parseInt(input.getAttribute('max'));
            if (currentValue < maxValue) {
                input.value = currentValue + 1;
            }
        }

        // Add to cart with quantity
        function addToCart(productId) {
            const quantity = parseInt(document.getElementById('quantity').value);
            ShopTechnology.addToCart(productId, quantity);
        }

        // Review form
        function showReviewForm() {
            // TODO: Implement review form modal
            alert('Tính năng viết đánh giá sẽ được cập nhật sớm!');
        }
    </script>
}
