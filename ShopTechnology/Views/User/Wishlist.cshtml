@model List<ShopTechnology.Models.Wishlist>
@{
    ViewData["Title"] = "Danh sách yêu thích";
}

<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2><i class="fas fa-heart"></i> Danh sách yêu thích</h2>
                <a asp-controller="User" asp-action="Dashboard" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Quay lại Dashboard
                </a>
            </div>

            @if (Model.Any())
            {
                <div class="row">
                    @foreach (var wishlistItem in Model)
                    {
                        <div class="col-md-4 col-lg-3 mb-4">
                            <div class="card h-100 shadow-sm">
                                <img src="@(wishlistItem.Product.ProductImages?.FirstOrDefault()?.ImageUrl ?? "/img/best-tech-accessories.png")"
                                     class="card-img-top" alt="@wishlistItem.Product.Name" 
                                     style="height: 200px; object-fit: cover;">
                                <div class="card-body d-flex flex-column">
                                    <h6 class="card-title">@wishlistItem.Product.Name</h6>
                                    <p class="card-text text-muted small">@wishlistItem.Product.Category?.Name</p>
                                    <p class="card-text text-primary fw-bold">@wishlistItem.Product.Price.ToString("N0") VNĐ</p>
                                    
                                    @if (wishlistItem.Product.StockQuantity > 0)
                                    {
                                        <p class="card-text">
                                            <small class="text-success">
                                                <i class="fas fa-check-circle"></i> Còn hàng: @wishlistItem.Product.StockQuantity
                                            </small>
                                        </p>
                                    }
                                    else
                                    {
                                        <p class="card-text">
                                            <small class="text-danger">
                                                <i class="fas fa-times-circle"></i> Hết hàng
                                            </small>
                                        </p>
                                    }
                                    
                                    <div class="mt-auto">
                                        <div class="d-grid gap-2">
                                            <a asp-controller="Product" asp-action="Details" asp-route-id="@wishlistItem.Product.ProductId"
                                               class="btn btn-outline-primary btn-sm">
                                                <i class="fas fa-eye"></i> Xem chi tiết
                                            </a>
                                            
                                            @if (wishlistItem.Product.StockQuantity > 0)
                                            {
                                                <a asp-controller="Cart" asp-action="AddToCart" asp-route-productId="@wishlistItem.Product.ProductId"
                                                   class="btn btn-success btn-sm">
                                                    <i class="fas fa-shopping-cart"></i> Thêm vào giỏ
                                                </a>
                                            }
                                            
                                            <form asp-controller="Wishlist" asp-action="RemoveFromWishlist" method="post" style="display: inline;">
                                                <input type="hidden" name="productId" value="@wishlistItem.Product.ProductId" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm w-100" 
                                                        onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này khỏi danh sách yêu thích?')">
                                                    <i class="fas fa-trash"></i> Xóa khỏi yêu thích
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-footer text-muted">
                                    <small>Thêm vào: @wishlistItem.CreatedAt.ToString("dd/MM/yyyy")</small>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-heart fa-4x text-muted mb-3"></i>
                        <h4 class="text-muted">Danh sách yêu thích trống</h4>
                        <p class="text-muted">Bạn chưa có sản phẩm nào trong danh sách yêu thích. Hãy khám phá các sản phẩm và thêm vào danh sách yêu thích!</p>
                        <a asp-controller="Product" asp-action="Index" class="btn btn-primary">
                            <i class="fas fa-shopping-cart"></i> Khám phá sản phẩm
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
