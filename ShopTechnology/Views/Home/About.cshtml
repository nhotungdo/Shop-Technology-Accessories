@{
    ViewData["Title"] = "Giới thiệu";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
}

<div class="about-header">
    <div class="container">
        <h1>Về chúng tôi</h1>
        <p>Shop Technology - Nơi công nghệ gặp gỡ cuộc sống</p>
    </div>
</div>

<div class="about-container">
    <div class="container">
        <!-- Company Story -->
        <section class="about-section">
            <div class="about-content">
                <div class="about-text">
                    <h2>Câu chuyện của chúng tôi</h2>
                    <p>Shop Technology được thành lập với mục tiêu mang đến những sản phẩm công nghệ chất lượng cao với
                        giá cả hợp lý cho người dùng Việt Nam. Chúng tôi tin rằng công nghệ không chỉ là những thiết bị
                        điện tử, mà còn là cầu nối giúp cuộc sống trở nên tiện lợi và thú vị hơn.</p>

                    <p>Từ những ngày đầu thành lập, chúng tôi đã cam kết cung cấp những sản phẩm chính hãng, dịch vụ
                        khách hàng tận tâm và trải nghiệm mua sắm trực tuyến tốt nhất. Với đội ngũ nhân viên trẻ, năng
                        động và am hiểu công nghệ, chúng tôi luôn sẵn sàng tư vấn và hỗ trợ khách hàng trong việc lựa
                        chọn sản phẩm phù hợp.</p>
                </div>
                <div class="about-image">
                    <img src="/img/about-story.jpg" alt="Câu chuyện Shop Technology" />
                </div>
            </div>
        </section>

        <!-- Mission & Vision -->
        <section class="mission-vision">
            <div class="mission-vision-grid">
                <div class="mission-card">
                    <div class="mission-icon">
                        <i class="fas fa-bullseye"></i>
                    </div>
                    <h3>Sứ mệnh</h3>
                    <p>Mang đến những sản phẩm công nghệ chất lượng cao, giá cả hợp lý và dịch vụ khách hàng xuất sắc,
                        giúp người dùng Việt Nam tiếp cận công nghệ một cách dễ dàng và hiệu quả.</p>
                </div>

                <div class="vision-card">
                    <div class="vision-icon">
                        <i class="fas fa-eye"></i>
                    </div>
                    <h3>Tầm nhìn</h3>
                    <p>Trở thành cửa hàng công nghệ hàng đầu Việt Nam, được tin tưởng và yêu mến bởi khách hàng, đối tác
                        và cộng đồng.</p>
                </div>

                <div class="values-card">
                    <div class="values-icon">
                        <i class="fas fa-heart"></i>
                    </div>
                    <h3>Giá trị cốt lõi</h3>
                    <p>Chất lượng, uy tín, sáng tạo và tận tâm - những giá trị không bao giờ thay đổi trong mọi hoạt
                        động của chúng tôi.</p>
                </div>
            </div>
        </section>

        <!-- Why Choose Us -->
        <section class="why-choose-us">
            <h2>Tại sao chọn Shop Technology?</h2>
            <div class="features-grid">
                <div class="feature-item">
                    <div class="feature-icon">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <h4>Sản phẩm chính hãng</h4>
                    <p>100% sản phẩm chính hãng với bảo hành chính thức từ nhà sản xuất</p>
                </div>

                <div class="feature-item">
                    <div class="feature-icon">
                        <i class="fas fa-truck"></i>
                    </div>
                    <h4>Giao hàng nhanh chóng</h4>
                    <p>Giao hàng toàn quốc với thời gian từ 1-3 ngày làm việc</p>
                </div>

                <div class="feature-item">
                    <div class="feature-icon">
                        <i class="fas fa-headset"></i>
                    </div>
                    <h4>Hỗ trợ 24/7</h4>
                    <p>Đội ngũ tư vấn chuyên nghiệp sẵn sàng hỗ trợ mọi lúc</p>
                </div>

                <div class="feature-item">
                    <div class="feature-icon">
                        <i class="fas fa-undo"></i>
                    </div>
                    <h4>Đổi trả dễ dàng</h4>
                    <p>Chính sách đổi trả linh hoạt trong 30 ngày đầu tiên</p>
                </div>

                <div class="feature-item">
                    <div class="feature-icon">
                        <i class="fas fa-credit-card"></i>
                    </div>
                    <h4>Thanh toán an toàn</h4>
                    <p>Nhiều phương thức thanh toán với bảo mật cao</p>
                </div>

                <div class="feature-item">
                    <div class="feature-icon">
                        <i class="fas fa-gift"></i>
                    </div>
                    <h4>Ưu đãi thường xuyên</h4>
                    <p>Chương trình khuyến mãi và giảm giá hấp dẫn</p>
                </div>
            </div>
        </section>

        <!-- Team -->
        <section class="team-section">
            <h2>Đội ngũ của chúng tôi</h2>
            <div class="team-grid">
                <div class="team-member">
                    <div class="member-avatar">
                        <img src="/img/team-1.jpg" alt="CEO" />
                    </div>
                    <h4>Nguyễn Văn A</h4>
                    <p class="member-position">CEO & Founder</p>
                    <p class="member-description">Với hơn 10 năm kinh nghiệm trong lĩnh vực công nghệ và thương mại điện
                        tử.</p>
                </div>

                <div class="team-member">
                    <div class="member-avatar">
                        <img src="/img/team-2.jpg" alt="CTO" />
                    </div>
                    <h4>Trần Thị B</h4>
                    <p class="member-position">CTO</p>
                    <p class="member-description">Chuyên gia về công nghệ thông tin và phát triển hệ thống.</p>
                </div>

                <div class="team-member">
                    <div class="member-avatar">
                        <img src="/img/team-3.jpg" alt="Marketing Manager" />
                    </div>
                    <h4>Lê Văn C</h4>
                    <p class="member-position">Marketing Manager</p>
                    <p class="member-description">Chuyên gia marketing số và phát triển thương hiệu.</p>
                </div>
            </div>
        </section>

        <!-- Statistics -->
        <section class="stats-section">
            <div class="stats-grid">
                <div class="stat-item">
                    <div class="stat-number">10,000+</div>
                    <div class="stat-label">Khách hàng hài lòng</div>
                </div>

                <div class="stat-item">
                    <div class="stat-number">5,000+</div>
                    <div class="stat-label">Sản phẩm đa dạng</div>
                </div>

                <div class="stat-item">
                    <div class="stat-number">50+</div>
                    <div class="stat-label">Thương hiệu đối tác</div>
                </div>

                <div class="stat-item">
                    <div class="stat-number">5+</div>
                    <div class="stat-label">Năm kinh nghiệm</div>
                </div>
            </div>
        </section>
    </div>
</div>
