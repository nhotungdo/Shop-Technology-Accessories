@{
    ViewData["Title"] = "Giới thiệu";
}

<div class="container">
    <div class="row">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-body">
                    <h1 class="text-center mb-4">
                        <i class="fas fa-store text-primary"></i> Về Shop Technology Accessories
                    </h1>
                    
                    <div class="row">
                        <div class="col-md-6">
                            <h3>Chào mừng đến với Shop Technology Accessories!</h3>
                            <p class="lead">
                                Chúng tôi là cửa hàng chuyên cung cấp các phụ kiện công nghệ hiện đại và chất lượng cao, 
                                đáp ứng mọi nhu cầu của khách hàng từ cá nhân đến doanh nghiệp.
                            </p>
                            
                            <h4 class="mt-4">Tại sao chọn chúng tôi?</h4>
                            <ul class="list-unstyled">
                                <li><i class="fas fa-check text-success"></i> Sản phẩm chính hãng, chất lượng cao</li>
                                <li><i class="fas fa-check text-success"></i> Giá cả cạnh tranh, phù hợp mọi túi tiền</li>
                                <li><i class="fas fa-check text-success"></i> Giao hàng nhanh chóng, an toàn</li>
                                <li><i class="fas fa-check text-success"></i> Dịch vụ khách hàng 24/7</li>
                                <li><i class="fas fa-check text-success"></i> Bảo hành chính hãng</li>
                            </ul>
                        </div>
                        
                        <div class="col-md-6">
                            <img src="https://via.placeholder.com/500x300/007bff/ffffff?text=Shop+Technology" 
                                 class="img-fluid rounded" alt="Shop Technology">
                        </div>
                    </div>
                    
                    <hr class="my-5">
                    
                    <div class="row">
                        <div class="col-md-4 text-center mb-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <i class="fas fa-mobile-alt fa-3x text-primary mb-3"></i>
                                    <h5>Phụ kiện điện thoại</h5>
                                    <p>Sạc, tai nghe, ốp lưng và nhiều phụ kiện khác cho điện thoại</p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-4 text-center mb-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <i class="fas fa-laptop fa-3x text-success mb-3"></i>
                                    <h5>Phụ kiện máy tính</h5>
                                    <p>Bàn phím, chuột, sạc laptop và các phụ kiện khác</p>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-4 text-center mb-4">
                            <div class="card h-100">
                                <div class="card-body">
                                    <i class="fas fa-headphones fa-3x text-warning mb-3"></i>
                                    <h5>Thiết bị âm thanh</h5>
                                    <p>Tai nghe có dây, không dây với chất lượng âm thanh cao</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
