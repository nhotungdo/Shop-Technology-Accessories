@using ShopTechnology.Models
@model HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
    <style>
        /* Hero Banner Styles */
        .hero-banner {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 80px 0;
            position: relative;
            overflow: hidden;
        }

        .hero-banner::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="25" cy="25" r="1" fill="white" opacity="0.1"/><circle cx="75" cy="75" r="1" fill="white" opacity="0.1"/><circle cx="50" cy="10" r="0.5" fill="white" opacity="0.1"/><circle cx="10" cy="60" r="0.5" fill="white" opacity="0.1"/><circle cx="90" cy="40" r="0.5" fill="white" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
            opacity: 0.3;
        }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .hero-product-card {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            padding: 30px;
            text-align: center;
            transition: transform 0.3s ease;
        }

        .hero-product-card:hover {
            transform: translateY(-10px);
        }

        .hero-product-image {
            width: 200px;
            height: 200px;
            object-fit: cover;
            border-radius: 15px;
            margin-bottom: 20px;
        }

        /* Category Grid Styles */
        .category-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 30px;
            margin: 50px 0;
        }

        .category-card {
            background: white;
            border-radius: 20px;
            padding: 40px 30px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
            border: 1px solid #f0f0f0;
        }

        .category-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        }

        .category-icon {
            font-size: 3rem;
            color: #667eea;
            margin-bottom: 20px;
        }

        .category-title {
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 15px;
            color: #333;
        }

        .category-description {
            color: #666;
            margin-bottom: 25px;
            line-height: 1.6;
        }

        /* Product Grid Styles */
        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
            margin: 40px 0;
        }

        .product-card {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            transition: all 0.3s ease;
            border: 1px solid #f0f0f0;
        }

        .product-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.15);
        }

        .product-image {
            width: 100%;
            height: 250px;
            object-fit: cover;
        }

        .product-info {
            padding: 25px;
        }

        .product-title {
            font-size: 1.2rem;
            font-weight: 600;
            margin-bottom: 10px;
            color: #333;
            line-height: 1.4;
        }

        .product-category {
            color: #667eea;
            font-size: 0.9rem;
            margin-bottom: 10px;
        }

        .product-price {
            font-size: 1.3rem;
            font-weight: 700;
            color: #e74c3c;
            margin-bottom: 15px;
        }

        .product-original-price {
            font-size: 1rem;
            color: #999;
            text-decoration: line-through;
            margin-right: 10px;
        }

        .product-discount {
            background: #e74c3c;
            color: white;
            padding: 4px 8px;
            border-radius: 12px;
            font-size: 0.8rem;
            font-weight: 600;
        }

        .product-rating {
            display: flex;
            align-items: center;
            margin-bottom: 15px;
        }

        .stars {
            color: #ffc107;
            margin-right: 10px;
        }

        .rating-text {
            color: #666;
            font-size: 0.9rem;
        }

        /* Section Styles */
        .section {
            margin: 80px 0;
        }

        .section-title {
            text-align: center;
            font-size: 2.5rem;
            font-weight: 700;
            margin-bottom: 20px;
            color: #333;
        }

        .section-subtitle {
            text-align: center;
            color: #666;
            font-size: 1.1rem;
            margin-bottom: 50px;
            max-width: 600px;
            margin-left: auto;
            margin-right: auto;
        }

        /* Promotion Styles */
        .promotion-card {
            background: linear-gradient(135deg, #ff6b6b, #ee5a24);
            color: white;
            border-radius: 20px;
            padding: 30px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .promotion-card::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 100%;
            height: 100%;
            background: rgba(255, 255, 255, 0.1);
            border-radius: 50%;
        }

        .promotion-badge {
            background: rgba(255, 255, 255, 0.2);
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
            display: inline-block;
            margin-bottom: 20px;
        }

        .countdown-timer {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin: 20px 0;
        }

        .countdown-item {
            background: rgba(255, 255, 255, 0.2);
            padding: 10px 15px;
            border-radius: 10px;
            text-align: center;
        }

        .countdown-number {
            font-size: 1.5rem;
            font-weight: 700;
            display: block;
        }

        .countdown-label {
            font-size: 0.8rem;
            opacity: 0.8;
        }

        /* Button Styles */
        .btn-modern {
            padding: 12px 30px;
            border-radius: 25px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
        }

        .btn-primary-modern {
            background: linear-gradient(135deg, #667eea, #764ba2);
            color: white;
        }

        .btn-primary-modern:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
            color: white;
        }

        .btn-secondary-modern {
            background: white;
            color: #667eea;
            border: 2px solid #667eea;
        }

        .btn-secondary-modern:hover {
            background: #667eea;
            color: white;
            transform: translateY(-2px);
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .hero-banner {
                padding: 40px 0;
            }

            .hero-product-image {
                width: 150px;
                height: 150px;
            }

            .category-grid {
                grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
                gap: 20px;
            }

            .product-grid {
                grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
                gap: 20px;
            }

            .section-title {
                font-size: 2rem;
            }
        }
    </style>
}

<!-- 1. Hero Banner với Sản Phẩm Nổi Bật -->
<section class="hero-banner">
    <div class="container">
        <div class="hero-content">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <h1 class="display-4 fw-bold mb-4">Shop Technology Accessories</h1>
                    <p class="lead mb-4">Khám phá bộ sưu tập phụ kiện công nghệ hiện đại với chất lượng cao và thiết kế
                        tinh tế</p>
                    <div class="d-flex gap-3 flex-wrap">
                        <a asp-controller="Product" asp-action="Index" class="btn btn-modern btn-primary-modern">
                            <i class="fas fa-shopping-bag me-2"></i>Khám phá ngay
                        </a>
                        @if (!User.Identity.IsAuthenticated)
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-modern btn-secondary-modern">
                                <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập
                            </a>
                        }
                        else
                        {
                            <a asp-controller="Cart" asp-action="Index" class="btn btn-modern btn-secondary-modern">
                                <i class="fas fa-shopping-cart me-2"></i>Giỏ hàng
                            </a>
                        }
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="row">
                        @if (Model.HeroProducts != null && Model.HeroProducts.Any())
                        {
                            @foreach (var product in Model.HeroProducts.Take(3))
                            {
                                <div class="col-md-4 mb-3">
                                    <div class="hero-product-card">
                                        <img src="@(product.ProductImages?.FirstOrDefault()?.ImageUrl ?? "/img/best-tech-accessories.png")"
                                            class="hero-product-image" alt="@product.Name">
                                        <h5 class="fw-bold">@product.Name</h5>
                                        <p class="mb-3">@product.Price.ToString("N0") VNĐ</p>
                                        <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductId"
                                            class="btn btn-modern btn-primary-modern btn-sm">
                                            <i class="fas fa-eye me-1"></i>Xem chi tiết
                                        </a>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <!-- Fallback hero products -->
                            <div class="col-md-4 mb-3">
                                <div class="hero-product-card">
                                    <i class="fas fa-headphones fa-4x mb-3"></i>
                                    <h5 class="fw-bold">Tai nghe không dây</h5>
                                    <p class="mb-3">Từ 299.000 VNĐ</p>
                                    <a asp-controller="Product" asp-action="Index"
                                        class="btn btn-modern btn-primary-modern btn-sm">
                                        <i class="fas fa-eye me-1"></i>Xem chi tiết
                                    </a>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="hero-product-card">
                                    <i class="fas fa-charging-station fa-4x mb-3"></i>
                                    <h5 class="fw-bold">Sạc nhanh</h5>
                                    <p class="mb-3">Từ 199.000 VNĐ</p>
                                    <a asp-controller="Product" asp-action="Index"
                                        class="btn btn-modern btn-primary-modern btn-sm">
                                        <i class="fas fa-eye me-1"></i>Xem chi tiết
                                    </a>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="hero-product-card">
                                    <i class="fas fa-mobile-alt fa-4x mb-3"></i>
                                    <h5 class="fw-bold">Ốp lưng điện thoại</h5>
                                    <p class="mb-3">Từ 99.000 VNĐ</p>
                                    <a asp-controller="Product" asp-action="Index"
                                        class="btn btn-modern btn-primary-modern btn-sm">
                                        <i class="fas fa-eye me-1"></i>Xem chi tiết
                                    </a>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="container">
    <!-- Welcome Section -->
    @if (User.Identity.IsAuthenticated)
    {
        <div class="welcome-section mt-5 mb-5">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h3 class="welcome-title">
                        <i class="fas fa-user-circle me-2"></i>Xin chào, @User.Identity.Name!
                    </h3>
                    <p class="welcome-text">Cảm ơn bạn đã quay trở lại. Hãy khám phá các sản phẩm mới nhất và ưu đãi đặc
                        biệt dành cho bạn.</p>
                </div>
                <div class="col-md-4 text-end">
                    <span class="role-badge @(User.IsInRole("Admin") ? "admin" : "user")">
                        <i class="fas fa-crown me-1"></i>@(User.IsInRole("Admin") ? "Admin" : "Khách hàng")
                    </span>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="welcome-section mt-5 mb-5">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h3 class="welcome-title">
                        <i class="fas fa-heart me-2"></i>Chào mừng bạn đến với Shop Technology!
                    </h3>
                    <p class="welcome-text">Bạn có thể xem tất cả sản phẩm mà không cần đăng nhập.
                        <a asp-controller="Account" asp-action="Login" class="text-decoration-none fw-bold">Đăng nhập</a>
                        hoặc
                        <a asp-controller="Account" asp-action="Register" class="text-decoration-none fw-bold">đăng ký</a>
                        để mua hàng và quản lý đơn hàng.
                    </p>
                </div>
                <div class="col-md-4 text-end">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-modern btn-primary-modern">
                        <i class="fas fa-user-plus me-2"></i>Đăng ký ngay
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- 2. Phân Loại Sản Phẩm Theo Danh Mục -->
    <section class="section">
        <h2 class="section-title">Danh mục sản phẩm</h2>
        <p class="section-subtitle">Khám phá các danh mục phụ kiện công nghệ đa dạng</p>

        <div class="category-grid">
            @if (Model.Categories != null && Model.Categories.Any())
            {
                @foreach (var category in Model.Categories.Take(6))
                {
                    <div class="category-card">
                        <i class="fas fa-th-large category-icon"></i>
                        <h3 class="category-title">@category.Name</h3>
                        <p class="category-description">Khám phá bộ sưu tập @category.Name chất lượng cao</p>
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@category.CategoryId"
                            class="btn btn-modern btn-primary-modern">
                            <i class="fas fa-arrow-right me-2"></i>Xem sản phẩm
                        </a>
                    </div>
                }
            }
            else
            {
                <!-- Fallback categories -->
                <div class="category-card">
                    <i class="fas fa-charging-station category-icon"></i>
                    <h3 class="category-title">Sạc & Pin</h3>
                    <p class="category-description">Sạc nhanh, pin dự phòng và phụ kiện sạc</p>
                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="1"
                        class="btn btn-modern btn-primary-modern">
                        <i class="fas fa-arrow-right me-2"></i>Xem sản phẩm
                    </a>
                </div>
                <div class="category-card">
                    <i class="fas fa-headphones category-icon"></i>
                    <h3 class="category-title">Tai nghe</h3>
                    <p class="category-description">Tai nghe không dây, có dây chất lượng cao</p>
                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="2"
                        class="btn btn-modern btn-primary-modern">
                        <i class="fas fa-arrow-right me-2"></i>Xem sản phẩm
                    </a>
                </div>
                <div class="category-card">
                    <i class="fas fa-mobile-alt category-icon"></i>
                    <h3 class="category-title">Case & Ốp lưng</h3>
                    <p class="category-description">Ốp lưng, case bảo vệ điện thoại</p>
                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="3"
                        class="btn btn-modern btn-primary-modern">
                        <i class="fas fa-arrow-right me-2"></i>Xem sản phẩm
                    </a>
                </div>
                <div class="category-card">
                    <i class="fas fa-keyboard category-icon"></i>
                    <h3 class="category-title">Bàn phím</h3>
                    <p class="category-description">Bàn phím cơ, không dây, gaming</p>
                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="4"
                        class="btn btn-modern btn-primary-modern">
                        <i class="fas fa-arrow-right me-2"></i>Xem sản phẩm
                    </a>
                </div>
                <div class="category-card">
                    <i class="fas fa-mouse category-icon"></i>
                    <h3 class="category-title">Chuột</h3>
                    <p class="category-description">Chuột gaming, không dây, ergonomic</p>
                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="5"
                        class="btn btn-modern btn-primary-modern">
                        <i class="fas fa-arrow-right me-2"></i>Xem sản phẩm
                    </a>
                </div>
                <div class="category-card">
                    <i class="fas fa-laptop category-icon"></i>
                    <h3 class="category-title">Phụ kiện Laptop</h3>
                    <p class="category-description">Túi laptop, đế tản nhiệt, adapter</p>
                    <a asp-controller="Product" asp-action="Index" asp-route-categoryId="6"
                        class="btn btn-modern btn-primary-modern">
                        <i class="fas fa-arrow-right me-2"></i>Xem sản phẩm
                    </a>
                </div>
            }
        </div>
    </section>

    <!-- 3. Sản Phẩm Bán Chạy Nhất -->
    <section class="section">
        <h2 class="section-title">Sản phẩm bán chạy</h2>
        <p class="section-subtitle">Những sản phẩm được khách hàng yêu thích nhất</p>

        <div class="product-grid">
            @if (Model.BestSellers != null && Model.BestSellers.Any())
            {
                @foreach (var product in Model.BestSellers.Take(9))
                {
                    <div class="product-card">
                        <img src="@(product.ProductImages?.FirstOrDefault()?.ImageUrl ?? "/img/best-tech-accessories.png")"
                            class="product-image" alt="@product.Name">
                        <div class="product-info">
                            <div class="product-category">
                                <i class="fas fa-tag me-1"></i>@product.Category?.Name
                            </div>
                            <h4 class="product-title">@product.Name</h4>
                            <div class="product-rating">
                                <div class="stars">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="fas fa-star @(i <= (product.AverageRating ?? 0) ? "" : "far")"></i>
                                    }
                                </div>
                                <span class="rating-text">(@(product.AverageRating?.ToString("0.0") ?? "0.0"))</span>
                            </div>
                            <div class="product-price">
                                @if (product.OriginalPrice > product.Price)
                                {
                                    <span class="product-original-price">@product.OriginalPrice?.ToString("N0") VNĐ</span>
                                    <span class="product-discount">-@((int)((product.OriginalPrice - product.Price) /
                                                                    product.OriginalPrice * 100))%</span>
                                }
                                <div>@product.Price.ToString("N0") VNĐ</div>
                            </div>
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductId"
                                class="btn btn-modern btn-primary-modern w-100">
                                <i class="fas fa-shopping-cart me-2"></i>Mua ngay
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <div class="p-5">
                        <i class="fas fa-fire fa-3x text-muted mb-3"></i>
                        <p class="text-muted">Không có sản phẩm bán chạy</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- 4. Khuyến Mãi Và Deal Đặc Biệt -->
    <section class="section">
        <h2 class="section-title">Ưu đãi hôm nay</h2>
        <p class="section-subtitle">Những deal đặc biệt không thể bỏ qua</p>

        <div class="row">
            @if (Model.PromotionalProducts != null && Model.PromotionalProducts.Any())
            {
                @foreach (var product in Model.PromotionalProducts.Take(6))
                {
                    <div class="col-lg-4 col-md-6 mb-4">
                        <div class="promotion-card">
                            <div class="promotion-badge">
                                <i class="fas fa-bolt me-1"></i>FLASH SALE
                            </div>
                            <img src="@(product.ProductImages?.FirstOrDefault()?.ImageUrl ?? "/img/best-tech-accessories.png")"
                                class="hero-product-image" alt="@product.Name">
                            <h4 class="fw-bold mb-3">@product.Name</h4>
                            <div class="product-price mb-3">
                                @if (product.OriginalPrice > product.Price)
                                {
                                    <span class="product-original-price">@product.OriginalPrice?.ToString("N0") VNĐ</span>
                                }
                                <div>@product.Price.ToString("N0") VNĐ</div>
                            </div>
                            <div class="countdown-timer">
                                <div class="countdown-item">
                                    <span class="countdown-number">23</span>
                                    <span class="countdown-label">Giờ</span>
                                </div>
                                <div class="countdown-item">
                                    <span class="countdown-number">59</span>
                                    <span class="countdown-label">Phút</span>
                                </div>
                                <div class="countdown-item">
                                    <span class="countdown-number">59</span>
                                    <span class="countdown-label">Giây</span>
                                </div>
                            </div>
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductId"
                                class="btn btn-modern btn-secondary-modern">
                                <i class="fas fa-shopping-cart me-2"></i>Mua ngay
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <div class="p-5">
                        <i class="fas fa-percentage fa-3x text-muted mb-3"></i>
                        <p class="text-muted">Không có khuyến mãi hiện tại</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- 5. Khuyến Nghị Cá Nhân Hóa -->
    <section class="section">
        <h2 class="section-title">Dành riêng cho bạn</h2>
        <p class="section-subtitle">Những sản phẩm được gợi ý dựa trên sở thích của bạn</p>

        <div class="product-grid">
            @if (Model.RecommendedProducts != null && Model.RecommendedProducts.Any())
            {
                @foreach (var product in Model.RecommendedProducts.Take(8))
                {
                    <div class="product-card">
                        <img src="@(product.ProductImages?.FirstOrDefault()?.ImageUrl ?? "/img/best-tech-accessories.png")"
                            class="product-image" alt="@product.Name">
                        <div class="product-info">
                            <div class="product-category">
                                <i class="fas fa-tag me-1"></i>@product.Category?.Name
                            </div>
                            <h4 class="product-title">@product.Name</h4>
                            <div class="product-rating">
                                <div class="stars">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="fas fa-star @(i <= (product.AverageRating ?? 0) ? "" : "far")"></i>
                                    }
                                </div>
                                <span class="rating-text">(@(product.AverageRating?.ToString("0.0") ?? "0.0"))</span>
                            </div>
                            <div class="product-price">
                                @if (product.OriginalPrice > product.Price)
                                {
                                    <span class="product-original-price">@product.OriginalPrice?.ToString("N0") VNĐ</span>
                                }
                                <div>@product.Price.ToString("N0") VNĐ</div>
                            </div>
                            <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductId"
                                class="btn btn-modern btn-primary-modern w-100">
                                <i class="fas fa-eye me-2"></i>Xem chi tiết
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <div class="p-5">
                        <i class="fas fa-user-heart fa-3x text-muted mb-3"></i>
                        <p class="text-muted">Đăng nhập để xem gợi ý cá nhân hóa</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Stats Section -->
    <section class="section">
        <div class="stats-section">
            <div class="row">
                <div class="col-md-3 col-6">
                    <div class="stat-item">
                        <div class="stat-number">1000+</div>
                        <div class="stat-label">Sản phẩm</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="stat-item">
                        <div class="stat-number">50+</div>
                        <div class="stat-label">Danh mục</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="stat-item">
                        <div class="stat-number">10K+</div>
                        <div class="stat-label">Khách hàng</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="stat-item">
                        <div class="stat-number">24/7</div>
                        <div class="stat-label">Hỗ trợ</div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        // Countdown timer for promotions
        function updateCountdown() {
            const countdownElements = document.querySelectorAll('.countdown-timer');
            countdownElements.forEach(timer => {
                const hours = timer.querySelector('.countdown-item:nth-child(1) .countdown-number');
                const minutes = timer.querySelector('.countdown-item:nth-child(2) .countdown-number');
                const seconds = timer.querySelector('.countdown-item:nth-child(3) .countdown-number');

                if (hours && minutes && seconds) {
                    let h = parseInt(hours.textContent);
                    let m = parseInt(minutes.textContent);
                    let s = parseInt(seconds.textContent);

                    s--;
                    if (s < 0) {
                        s = 59;
                        m--;
                        if (m < 0) {
                            m = 59;
                            h--;
                            if (h < 0) {
                                h = 23;
                            }
                        }
                    }

                    hours.textContent = h.toString().padStart(2, '0');
                    minutes.textContent = m.toString().padStart(2, '0');
                    seconds.textContent = s.toString().padStart(2, '0');
                }
            });
        }

        // Update countdown every second
        setInterval(updateCountdown, 1000);

        // Smooth scrolling for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Add animation on scroll
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.opacity = '1';
                    entry.target.style.transform = 'translateY(0)';
                }
            });
        }, observerOptions);

        // Observe all product cards and category cards
        document.querySelectorAll('.product-card, .category-card').forEach(card => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(30px)';
            card.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
            observer.observe(card);
        });
    </script>
}
