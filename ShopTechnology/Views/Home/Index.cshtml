@using ShopTechnology.Models
@model HomeViewModel
@{
    ViewData["Title"] = "Trang chủ";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
}

<!-- Hero Section -->
<div class="hero-section">
    <div class="floating-shapes">
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
    </div>
    <div class="container">
        <div class="row align-items-center hero-content">
            <div class="col-lg-6">
                <h1 class="hero-title">Shop Technology Accessories</h1>
                <p class="hero-subtitle">Khám phá bộ sưu tập phụ kiện công nghệ hiện đại với chất lượng cao và thiết kế
                    tinh tế</p>
                <div class="d-flex gap-3 flex-wrap">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-modern btn-primary-modern">
                        <i class="fas fa-shopping-bag me-2"></i>Khám phá ngay
                    </a>
                    @if (!User.Identity.IsAuthenticated)
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-modern btn-secondary-modern">
                            <i class="fas fa-sign-in-alt me-2"></i>Đăng nhập
                        </a>
                    }
                    else
                    {
                        <a asp-controller="Cart" asp-action="Index" class="btn btn-modern btn-secondary-modern">
                            <i class="fas fa-shopping-cart me-2"></i>Giỏ hàng
                        </a>
                    }
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <i class="fas fa-laptop fa-10x" style="opacity: 0.8;"></i>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <!-- Welcome Section -->
    @if (User.Identity.IsAuthenticated)
    {
        <div class="welcome-section">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h3 class="welcome-title">
                        <i class="fas fa-user-circle me-2"></i>Xin chào, @User.Identity.Name!
                    </h3>
                    <p class="welcome-text">Cảm ơn bạn đã quay trở lại. Hãy khám phá các sản phẩm mới nhất và ưu đãi đặc
                        biệt dành cho bạn.</p>
                </div>
                <div class="col-md-4 text-end">
                    <span class="role-badge @(User.IsInRole("Admin") ? "admin" : "user")">
                        <i class="fas fa-crown me-1"></i>@(User.IsInRole("Admin") ? "Admin" : "Khách hàng")
                    </span>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="welcome-section">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h3 class="welcome-title">
                        <i class="fas fa-heart me-2"></i>Chào mừng bạn đến với Shop Technology!
                    </h3>
                    <p class="welcome-text">Bạn có thể xem tất cả sản phẩm mà không cần đăng nhập.
                        <a asp-controller="Account" asp-action="Login" class="text-decoration-none fw-bold">Đăng nhập</a>
                        hoặc
                        <a asp-controller="Account" asp-action="Register" class="text-decoration-none fw-bold">đăng ký</a>
                        để mua hàng và quản lý đơn hàng.
                    </p>
                </div>
                <div class="col-md-4 text-end">
                    <a asp-controller="Account" asp-action="Register" class="btn btn-modern btn-primary-modern">
                        <i class="fas fa-user-plus me-2"></i>Đăng ký ngay
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- Featured Products Section -->
    <section class="section-padding mb-section">
        <h2 class="section-title">
            <i class="fas fa-star me-3"></i>Sản phẩm nổi bật
        </h2>
        <div class="row">
            @if (Model.FeaturedProducts != null && Model.FeaturedProducts.Any())
            {
                @foreach (var product in Model.FeaturedProducts)
                {
                    <div class="col-lg-3 col-md-6 mb-4">
                        <div class="card card-modern h-100">
                            <img src="@(product.ProductImages?.FirstOrDefault()?.ImageUrl ?? "/img/best-tech-accessories.png")"
                                class="card-img-modern" alt="@product.Name">
                            <div class="card-body-modern d-flex flex-column">
                                <h5 class="card-title-modern">@product.Name</h5>
                                <p class="card-category">
                                    <i class="fas fa-tag me-1"></i>@product.Category?.Name
                                </p>
                                <p class="card-price">@product.Price.ToString("N0") VNĐ</p>
                                <p class="text-muted small mb-3">
                                    <i class="fas fa-box me-1"></i>Còn lại: @product.StockQuantity
                                </p>
                                <div class="mt-auto">
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductId"
                                        class="btn btn-card w-100">
                                        <i class="fas fa-eye me-2"></i>Xem chi tiết
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <div class="p-5">
                        <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                        <p class="text-muted">Không có sản phẩm nổi bật</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Latest Products Section -->
    <section class="section-padding mb-section">
        <h2 class="section-title">
            <i class="fas fa-clock me-3"></i>Sản phẩm mới nhất
        </h2>
        <div class="row">
            @if (Model.LatestProducts != null && Model.LatestProducts.Any())
            {
                @foreach (var product in Model.LatestProducts)
                {
                    <div class="col-lg-2 col-md-4 col-6 mb-4">
                        <div class="card card-modern h-100">
                            <img src="@(product.ProductImages?.FirstOrDefault()?.ImageUrl ?? "/images/no-image.png")"
                                class="card-img-modern" alt="@product.Name" style="height: 180px;">
                            <div class="card-body-modern d-flex flex-column">
                                <h6 class="card-title-modern">@product.Name</h6>
                                <p class="card-price">@product.Price.ToString("N0") VNĐ</p>
                                <div class="mt-auto">
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductId"
                                        class="btn btn-card w-100">
                                        <i class="fas fa-eye me-1"></i>Xem
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center">
                    <div class="p-5">
                        <i class="fas fa-clock fa-3x text-muted mb-3"></i>
                        <p class="text-muted">Không có sản phẩm mới</p>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Categories Section -->
    <section class="section-padding mb-section">
        <h2 class="section-title">
            <i class="fas fa-th-large me-3"></i>Danh mục sản phẩm
        </h2>
        <div class="row">
            @if (Model.Categories != null && Model.Categories.Any())
            {
                @foreach (var category in Model.Categories.Take(6))
                {
                    <div class="col-lg-2 col-md-4 col-6 mb-4">
                        <div class="category-card">
                            <i class="fas fa-th-large category-icon"></i>
                            <h5 class="category-title">@category.Name</h5>
                            <a asp-controller="Product" asp-action="Index" asp-route-categoryId="@category.CategoryId"
                                class="btn btn-card">
                                <i class="fas fa-arrow-right me-1"></i>Xem sản phẩm
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <!-- Fallback categories -->
                <div class="col-lg-2 col-md-4 col-6 mb-4">
                    <div class="category-card">
                        <i class="fas fa-charging-station category-icon"></i>
                        <h5 class="category-title">Sạc</h5>
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="1" class="btn btn-card">
                            <i class="fas fa-arrow-right me-1"></i>Xem sản phẩm
                        </a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-4 col-6 mb-4">
                    <div class="category-card">
                        <i class="fas fa-headphones category-icon"></i>
                        <h5 class="category-title">Tai nghe</h5>
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="2" class="btn btn-card">
                            <i class="fas fa-arrow-right me-1"></i>Xem sản phẩm
                        </a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-4 col-6 mb-4">
                    <div class="category-card">
                        <i class="fas fa-mobile-alt category-icon"></i>
                        <h5 class="category-title">Ốp lưng</h5>
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="3" class="btn btn-card">
                            <i class="fas fa-arrow-right me-1"></i>Xem sản phẩm
                        </a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-4 col-6 mb-4">
                    <div class="category-card">
                        <i class="fas fa-keyboard category-icon"></i>
                        <h5 class="category-title">Bàn phím</h5>
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="4" class="btn btn-card">
                            <i class="fas fa-arrow-right me-1"></i>Xem sản phẩm
                        </a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-4 col-6 mb-4">
                    <div class="category-card">
                        <i class="fas fa-mouse category-icon"></i>
                        <h5 class="category-title">Chuột</h5>
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="5" class="btn btn-card">
                            <i class="fas fa-arrow-right me-1"></i>Xem sản phẩm
                        </a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-4 col-6 mb-4">
                    <div class="category-card">
                        <i class="fas fa-laptop category-icon"></i>
                        <h5 class="category-title">Laptop</h5>
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="6" class="btn btn-card">
                            <i class="fas fa-arrow-right me-1"></i>Xem sản phẩm
                        </a>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Stats Section -->
    <section class="section-padding">
        <div class="stats-section">
            <div class="row">
                <div class="col-md-3 col-6">
                    <div class="stat-item">
                        <div class="stat-number">1000+</div>
                        <div class="stat-label">Sản phẩm</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="stat-item">
                        <div class="stat-number">50+</div>
                        <div class="stat-label">Danh mục</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="stat-item">
                        <div class="stat-number">10K+</div>
                        <div class="stat-label">Khách hàng</div>
                    </div>
                </div>
                <div class="col-md-3 col-6">
                    <div class="stat-item">
                        <div class="stat-number">24/7</div>
                        <div class="stat-label">Hỗ trợ</div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
