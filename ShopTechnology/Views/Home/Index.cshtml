@{
    ViewData["Title"] = "Trang chủ";
}

<div class="hero-section bg-primary text-white py-5 mb-5">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1 class="display-4 fw-bold">Shop Technology Accessories</h1>
                <p class="lead">Cửa hàng chuyên cung cấp các phụ kiện công nghệ hiện đại và chất lượng cao</p>
                <a asp-controller="Product" asp-action="Index" class="btn btn-light btn-lg">Khám phá ngay</a>
            </div>
            <div class="col-md-6 text-center">
                <i class="fas fa-laptop fa-8x"></i>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <!-- Sản phẩm nổi bật -->
    <section class="mb-5">
        <h2 class="text-center mb-4">
            <i class="fas fa-star text-warning"></i> Sản phẩm nổi bật
        </h2>
        <div class="row">
            @foreach (var product in ViewBag.FeaturedProducts)
            {
                <div class="col-md-3 mb-4">
                    <div class="card h-100 shadow-sm">
                        <img src="@product.MainImageUrl" class="card-img-top" alt="@product.ProductName" style="height: 200px; object-fit: cover;">
                        <div class="card-body d-flex flex-column">
                            <h5 class="card-title">@product.ProductName</h5>
                            <p class="card-text text-muted">@product.CategoryName</p>
                            <p class="card-text text-primary fw-bold">@product.Price.ToString("N0") VNĐ</p>
                            <div class="mt-auto">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductId" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-eye"></i> Chi tiết
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Sản phẩm mới nhất -->
    <section class="mb-5">
        <h2 class="text-center mb-4">
            <i class="fas fa-clock text-info"></i> Sản phẩm mới nhất
        </h2>
        <div class="row">
            @foreach (var product in ViewBag.NewestProducts)
            {
                <div class="col-md-2 mb-4">
                    <div class="card h-100 shadow-sm">
                        <img src="@product.MainImageUrl" class="card-img-top" alt="@product.ProductName" style="height: 150px; object-fit: cover;">
                        <div class="card-body d-flex flex-column">
                            <h6 class="card-title">@product.ProductName</h6>
                            <p class="card-text text-primary fw-bold">@product.Price.ToString("N0") VNĐ</p>
                            <div class="mt-auto">
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@product.ProductId" class="btn btn-outline-primary btn-sm">
                                    <i class="fas fa-eye"></i> Xem
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Danh mục sản phẩm -->
    <section class="mb-5">
        <h2 class="text-center mb-4">
            <i class="fas fa-th-large text-success"></i> Danh mục sản phẩm
        </h2>
        <div class="row">
            <div class="col-md-2 mb-3">
                <div class="card text-center h-100">
                    <div class="card-body">
                        <i class="fas fa-charging-station fa-3x text-primary mb-3"></i>
                        <h5 class="card-title">Sạc</h5>
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="1" class="btn btn-outline-primary btn-sm">Xem sản phẩm</a>
                    </div>
                </div>
            </div>
            <div class="col-md-2 mb-3">
                <div class="card text-center h-100">
                    <div class="card-body">
                        <i class="fas fa-headphones fa-3x text-info mb-3"></i>
                        <h5 class="card-title">Tai nghe</h5>
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="2" class="btn btn-outline-info btn-sm">Xem sản phẩm</a>
                    </div>
                </div>
            </div>
            <div class="col-md-2 mb-3">
                <div class="card text-center h-100">
                    <div class="card-body">
                        <i class="fas fa-mobile-alt fa-3x text-success mb-3"></i>
                        <h5 class="card-title">Ốp lưng</h5>
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="3" class="btn btn-outline-success btn-sm">Xem sản phẩm</a>
                    </div>
                </div>
            </div>
            <div class="col-md-2 mb-3">
                <div class="card text-center h-100">
                    <div class="card-body">
                        <i class="fas fa-keyboard fa-3x text-warning mb-3"></i>
                        <h5 class="card-title">Bàn phím</h5>
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="4" class="btn btn-outline-warning btn-sm">Xem sản phẩm</a>
                    </div>
                </div>
            </div>
            <div class="col-md-2 mb-3">
                <div class="card text-center h-100">
                    <div class="card-body">
                        <i class="fas fa-mouse fa-3x text-danger mb-3"></i>
                        <h5 class="card-title">Chuột</h5>
                        <a asp-controller="Product" asp-action="Index" asp-route-categoryId="5" class="btn btn-outline-danger btn-sm">Xem sản phẩm</a>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>
