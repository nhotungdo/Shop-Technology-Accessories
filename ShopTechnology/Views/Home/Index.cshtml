@model ShopTechnology.Models.HomeViewModel
@using ShopTechnology.Models

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" />
}

<!-- Hero Section -->
<section class="hero-section bg-gradient-primary text-white py-5">
    <div class="container">
        <div class="row align-items-center min-vh-75">
            <div class="col-lg-6">
                <h1 class="display-4 fw-bold mb-4">Chào mừng đến với Shop Technology</h1>
                <p class="lead mb-4">Khám phá thế giới công nghệ với những sản phẩm chất lượng cao, giá cả hợp lý và
                    dịch vụ tận tâm.</p>
                <div class="hero-buttons">
                    <a href="#products" class="btn btn-light btn-lg me-3 mb-2">
                        <i class="fas fa-shopping-bag me-2"></i>Xem sản phẩm
                    </a>
                    <a href="#categories" class="btn btn-outline-light btn-lg mb-2">
                        <i class="fas fa-tags me-2"></i>Danh mục
                    </a>
                </div>
            </div>
            <div class="col-lg-6 text-center">
                <img src="/img/hero-tech.png" alt="Technology" class="img-fluid" style="max-height: 400px;">
            </div>
        </div>
    </div>
</section>

<!-- Banner Slider -->
@if (Model.Banners != null && Model.Banners.Any())
{
    <section class="banner-section py-5 bg-light">
        <div class="container">
            <div id="bannerCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-inner">
                    @foreach (var banner in Model.Banners)
                    {
                        <div class="carousel-item @(banner == Model.Banners.First() ? "active" : "")">
                            <div class="banner-item position-relative rounded overflow-hidden">
                                <img src="@banner.ImageUrl" alt="@banner.Title" class="w-100"
                                    style="height: 300px; object-fit: cover;">
                                <div class="banner-overlay position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center"
                                    style="background: rgba(0,0,0,0.4);">
                                    <div class="container">
                                        <div class="row">
                                            <div class="col-lg-6">
                                                <h2 class="text-white fw-bold mb-3">@banner.Title</h2>
                                                <p class="text-white-50 mb-4">Banner mô tả</p>
                                                <a href="@banner.LinkUrl" class="btn btn-primary btn-lg">Xem thêm</a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#bannerCarousel" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon"></span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#bannerCarousel" data-bs-slide="next">
                    <span class="carousel-control-next-icon"></span>
                </button>
            </div>
        </div>
    </section>
}

<!-- Categories Section -->
@if (Model.Categories != null && Model.Categories.Any())
{
    <section id="categories" class="categories-section py-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="display-5 fw-bold mb-3">Danh mục sản phẩm</h2>
                <p class="lead text-muted">Khám phá các danh mục sản phẩm đa dạng của chúng tôi</p>
            </div>

            <div class="row g-4">
                @foreach (var category in Model.Categories.Take(6))
                {
                    <div class="col-md-4 col-lg-2">
                        <a href="@Url.Action("Index", "Product", new { categoryId = category.CategoryId })"
                            class="category-card text-decoration-none">
                            <div class="card h-100 border-0 shadow-sm hover-lift">
                                <div class="card-body text-center p-4">
                                    <div class="category-icon mb-3">
                                        <img src="@category.ImageUrl" alt="@category.Name" class="img-fluid rounded"
                                            style="width: 80px; height: 80px; object-fit: cover;">
                                    </div>
                                    <h5 class="card-title fw-bold text-dark mb-2">@category.Name</h5>
                                    <p class="card-text text-muted small">@(category.Products?.Count ?? 0) sản phẩm</p>
                                </div>
                            </div>
                        </a>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Featured Products Section -->
@if (Model.FeaturedProducts != null && Model.FeaturedProducts.Any())
{
    <section id="products" class="featured-section py-5 bg-light">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="display-5 fw-bold mb-3">Sản phẩm nổi bật</h2>
                <p class="lead text-muted">Những sản phẩm được yêu thích nhất</p>
            </div>

            <div class="row g-4">
                @foreach (var product in Model.FeaturedProducts.Take(8))
                {
                    <div class="col-md-6 col-lg-3">
                        <div class="product-card card h-100 border-0 shadow-sm hover-lift" data-product-id="@product.ProductId">
                            <div class="product-image position-relative">
                                <img src="@(product.ProductImages?.FirstOrDefault(img => img.IsMain)?.ImageUrl ?? "/img/placeholder.jpg")"
                                    alt="@product.Name" class="card-img-top" style="height: 200px; object-fit: cover;">

                                <div class="product-badges position-absolute top-0 start-0 p-2">
                                    @if (product.IsNew)
                                    {
                                        <span class="badge bg-success me-1">Mới</span>
                                    }
                                    @if (product.IsHot)
                                    {
                                        <span class="badge bg-danger me-1">Hot</span>
                                    }
                                    @if (product.Price < 1000000)
                                    {
                                        <span class="badge bg-warning">Sale</span>
                                    }
                                </div>

                                <div class="product-actions position-absolute top-0 end-0 p-2">
                                    <button type="button" class="btn btn-light btn-sm mb-1"
                                        onclick="addToWishlist(@product.ProductId)" title="Thêm vào yêu thích">
                                        <i class="far fa-heart"></i>
                                    </button>
                                    <button type="button" class="btn btn-light btn-sm" onclick="quickView(@product.ProductId)"
                                        title="Xem nhanh">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title fw-bold mb-2">
                                    <a href="/Product/Details/@product.ProductId"
                                        class="text-decoration-none text-dark">@product.Name</a>
                                </h5>

                                <div class="product-rating mb-2">
                                    @{
                                        var reviews = product.Reviews?.ToList() ?? new List<Review>();
                                        var avgRating = reviews.Any() ? reviews.Average(r => r.Rating) : 0;
                                        var reviewCount = reviews.Count;
                                    }
                                    <div class="stars text-warning">
                                        @for (int i = 1; i <= 5; i++)
                                        {
                                            if (i <= avgRating)
                                            {
                                                <i class="fas fa-star"></i>
                                            }
                                            else
                                            {
                                                <i class="far fa-star"></i>
                                            }
                                        }
                                    </div>
                                    <small class="text-muted">(@reviewCount đánh giá)</small>
                                </div>

                                <div class="product-price mb-3">
                                    <span class="current-price fw-bold text-primary fs-5">@product.Price.ToString("N0") ₫</span>
                                </div>

                                <div class="mt-auto">
                                    <button type="button" class="btn btn-primary w-100" onclick="addToCart(@product.ProductId)">
                                        <i class="fas fa-shopping-cart me-2"></i>Thêm vào giỏ
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <div class="text-center mt-5">
                <a href="/Product" class="btn btn-outline-primary btn-lg">
                    Xem tất cả sản phẩm
                    <i class="fas fa-arrow-right ms-2"></i>
                </a>
            </div>
        </div>
    </section>
}

<!-- New Products Section -->
@if (Model.NewProducts != null && Model.NewProducts.Any())
{
    <section class="new-products-section py-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="display-5 fw-bold mb-3">Sản phẩm mới</h2>
                <p class="lead text-muted">Những sản phẩm mới nhất từ các thương hiệu hàng đầu</p>
            </div>

            <div class="row g-4">
                @foreach (var product in Model.NewProducts.Take(4))
                {
                    <div class="col-md-6 col-lg-3">
                        <div class="product-card card h-100 border-0 shadow-sm hover-lift" data-product-id="@product.ProductId">
                            <div class="product-image position-relative">
                                <img src="@(product.ProductImages?.FirstOrDefault(img => img.IsMain)?.ImageUrl ?? "/img/placeholder.jpg")"
                                    alt="@product.Name" class="card-img-top" style="height: 200px; object-fit: cover;">

                                <div class="product-badges position-absolute top-0 start-0 p-2">
                                    <span class="badge bg-success">Mới</span>
                                </div>
                            </div>

                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title fw-bold mb-2">
                                    <a href="/Product/Details/@product.ProductId"
                                        class="text-decoration-none text-dark">@product.Name</a>
                                </h5>

                                <div class="product-price mb-3">
                                    <span class="current-price fw-bold text-primary fs-5">@product.Price.ToString("N0") ₫</span>
                                </div>

                                <div class="mt-auto">
                                    <button type="button" class="btn btn-primary w-100" onclick="addToCart(@product.ProductId)">
                                        <i class="fas fa-shopping-cart me-2"></i>Thêm vào giỏ
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Hot Products Section -->
@if (Model.HotProducts != null && Model.HotProducts.Any())
{
    <section class="hot-products-section py-5 bg-light">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="display-5 fw-bold mb-3">Sản phẩm hot</h2>
                <p class="lead text-muted">Những sản phẩm được săn đón nhiều nhất</p>
            </div>

            <div class="row g-4">
                @foreach (var product in Model.HotProducts.Take(4))
                {
                    <div class="col-md-6 col-lg-3">
                        <div class="product-card card h-100 border-0 shadow-sm hover-lift" data-product-id="@product.ProductId">
                            <div class="product-image position-relative">
                                <img src="@(product.ProductImages?.FirstOrDefault(img => img.IsMain)?.ImageUrl ?? "/img/placeholder.jpg")"
                                    alt="@product.Name" class="card-img-top" style="height: 200px; object-fit: cover;">

                                <div class="product-badges position-absolute top-0 start-0 p-2">
                                    <span class="badge bg-danger">Hot</span>
                                </div>
                            </div>

                            <div class="card-body d-flex flex-column">
                                <h5 class="card-title fw-bold mb-2">
                                    <a href="/Product/Details/@product.ProductId"
                                        class="text-decoration-none text-dark">@product.Name</a>
                                </h5>

                                <div class="product-price mb-3">
                                    <span class="current-price fw-bold text-primary fs-5">@product.Price.ToString("N0") ₫</span>
                                </div>

                                <div class="mt-auto">
                                    <button type="button" class="btn btn-primary w-100" onclick="addToCart(@product.ProductId)">
                                        <i class="fas fa-shopping-cart me-2"></i>Thêm vào giỏ
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}

<!-- Features Section -->
<section class="features-section py-5">
    <div class="container">
        <div class="row g-4">
            <div class="col-md-3">
                <div class="text-center">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-shipping-fast fa-3x text-primary"></i>
                    </div>
                    <h5 class="fw-bold">Giao hàng nhanh</h5>
                    <p class="text-muted">Giao hàng toàn quốc trong 1-3 ngày</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="text-center">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-shield-alt fa-3x text-primary"></i>
                    </div>
                    <h5 class="fw-bold">Bảo hành chính hãng</h5>
                    <p class="text-muted">100% sản phẩm chính hãng</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="text-center">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-headset fa-3x text-primary"></i>
                    </div>
                    <h5 class="fw-bold">Hỗ trợ 24/7</h5>
                    <p class="text-muted">Tư vấn và hỗ trợ mọi lúc</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="text-center">
                    <div class="feature-icon mb-3">
                        <i class="fas fa-undo fa-3x text-primary"></i>
                    </div>
                    <h5 class="fw-bold">Đổi trả dễ dàng</h5>
                    <p class="text-muted">30 ngày đổi trả miễn phí</p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>     function addToCart(productId) {         // Implement add to cart functionality         console.log('Adding product to cart:', productId);         alert('Đã thêm sản phẩm vào giỏ hàng!');     }
            function addToWishlist(productId) {         // Implement add to wishlist functionality         console.log('Adding product to wishlist:', productId);         alert('Đã thêm sản phẩm vào danh sách yêu thích!');     }
                function quickView(productId) {         // Implement quick view functionality         console.log('Quick view product:', productId);         window.location.href = `/Product/Details/${productId}`;     }
    </script>
}
