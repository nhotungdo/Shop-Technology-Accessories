@model List<ShopTechnology.Models.Order>
@{
	ViewData["Title"] = "Quản lý đơn hàng";
}

<h2 class="mb-3"><i class="fas fa-clipboard-list"></i> Đơn hàng</h2>

<table class="table table-striped">
	<thead>
		<tr>
			<th>Mã</th>
			<th>Ngày</th>
			<th>Khách</th>
			<th>Trạng thái</th>
			<th>Tổng</th>
			<th></th>
		</tr>
	</thead>
	<tbody>
		@foreach (var o in Model)
		{
			<tr>
				<td>@o.OrderId</td>
				<td>@o.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
				<td>@o.UserId</td>
				<td>
					<form asp-action="UpdateStatus" method="post" class="d-flex gap-2">
						<input type="hidden" name="id" value="@o.OrderId" />
						<select name="status" class="form-select form-select-sm" style="width:180px">
							@foreach (var st in new[]{"Pending","Paid","Shipped","Completed","Canceled"})
							{
								<option value="@st" selected="@(o.Status==st)">@st</option>
							}
						</select>
						<button class="btn btn-sm btn-primary">Lưu</button>
					</form>
				</td>
				<td>@o.TotalAmount.ToString("N0")</td>
				<td></td>
			</tr>
		}
	</tbody>
</table>
