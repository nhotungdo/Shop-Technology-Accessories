@model ShopTechnology.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<!-- Welcome Section -->
<div class="row mb-4">
    <div class="col-12">
        <div class="stat-card">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <h2 class="stat-value mb-2">Chào mừng trở lại!</h2>
                    <p class="stat-label mb-0">Tổng quan hoạt động cửa hàng Shop Technology</p>
                </div>
                <div class="stat-icon primary">
                    <i class="fas fa-chart-line"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row mb-4">
    <!-- Revenue Statistics -->
    <div class="col-xl-3 col-md-6 mb-4">
        <div class="stat-card primary">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <p class="stat-label">Doanh thu hôm nay</p>
                    <h3 class="stat-value">@Model.TodayRevenue.ToString("C0")</h3>
                    <div class="stat-change positive">
                        <i class="fas fa-arrow-up"></i> Tuần: @Model.WeekRevenue.ToString("C0")
                    </div>
                </div>
                <div class="stat-icon primary">
                    <i class="fas fa-dollar-sign"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="stat-card success">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <p class="stat-label">Đơn hàng hôm nay</p>
                    <h3 class="stat-value">@Model.TodayOrders</h3>
                    <div class="stat-change positive">
                        <i class="fas fa-arrow-up"></i> Tuần: @Model.WeekOrders
                    </div>
                </div>
                <div class="stat-icon success">
                    <i class="fas fa-shopping-cart"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="stat-card warning">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <p class="stat-label">Người dùng mới</p>
                    <h3 class="stat-value">@Model.TodayUsers</h3>
                    <div class="stat-change positive">
                        <i class="fas fa-arrow-up"></i> Tuần: @Model.WeekUsers
                    </div>
                </div>
                <div class="stat-icon warning">
                    <i class="fas fa-users"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6 mb-4">
        <div class="stat-card danger">
            <div class="d-flex align-items-center justify-content-between">
                <div>
                    <p class="stat-label">Đơn hàng chờ xử lý</p>
                    <h3 class="stat-value">@Model.PendingOrders</h3>
                    <div class="stat-change">
                        Tổng: @Model.TotalOrders đơn hàng
                    </div>
                </div>
                <div class="stat-icon danger">
                    <i class="fas fa-clock"></i>
                </div>
            </div>
        </div>
    </div>
    </div>

    <!-- Additional Statistics -->
    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-secondary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-secondary text-uppercase mb-1">
                                Tổng sản phẩm
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalProducts</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-boxes fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-dark shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-dark text-uppercase mb-1">
                                Danh mục
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TotalCategories</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-list fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-danger shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                                Sản phẩm hết hàng
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.LowStockProducts.Count(p =>
                                                                p.StockQuantity == 0)</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-exclamation-triangle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-light shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-light text-uppercase mb-1">
                                Sản phẩm bán chạy
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.TopSellingProducts.Count</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-star fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Content Row -->
    <div class="row">
        <!-- Recent Orders -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Đơn hàng gần đây</h6>
                    <a href="@Url.Action("Index", "Orders")" class="btn btn-sm btn-primary">Xem tất cả</a>
                </div>
                <div class="card-body">
                    @if (Model.RecentOrders.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Mã đơn</th>
                                        <th>Khách hàng</th>
                                        <th>Tổng tiền</th>
                                        <th>Trạng thái</th>
                                        <th>Ngày tạo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var order in Model.RecentOrders.Take(5))
                                    {
                                        <tr>
                                            <td>
                                                <a href="@Url.Action("Details", "Orders", new { id = order.OrderId })">
                                                    @order.OrderNumber
                                                </a>
                                            </td>
                                            <td>@order.UserFullName</td>
                                            <td>@order.TotalAmount.ToString("C0")</td>
                                            <td>
                                                <span
                                                    class="badge badge-@(order.Status == "Completed" ? "success" : order.Status == "Pending" ? "warning" : "info")">
                                                    @order.StatusDisplay
                                                </span>
                                            </td>
                                            <td>@order.CreatedAt.ToString("dd/MM/yyyy")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Chưa có đơn hàng nào.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Top Selling Products -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-primary">Sản phẩm bán chạy</h6>
                    <a href="@Url.Action("Index", "Products")" class="btn btn-sm btn-primary">Xem tất cả</a>
                </div>
                <div class="card-body">
                    @if (Model.TopSellingProducts.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Sản phẩm</th>
                                        <th>Đã bán</th>
                                        <th>Giá</th>
                                        <th>Doanh thu</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in Model.TopSellingProducts)
                                    {
                                        <tr>
                                            <td>
                                                <a href="@Url.Action("Details", "Products", new { id = product.ProductId })">
                                                    @product.ProductName
                                                </a>
                                            </td>
                                            <td>
                                                <span class="badge badge-success">@product.TotalSold</span>
                                            </td>
                                            <td>@product.Price.ToString("C0")</td>
                                            <td>@((product.Price * product.TotalSold).ToString("C0"))</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Chưa có dữ liệu bán hàng.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Second Row -->
    <div class="row">
        <!-- Low Stock Products -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow">
                <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
                    <h6 class="m-0 font-weight-bold text-warning">Sản phẩm sắp hết hàng</h6>
                    <a href="@Url.Action("Index", "Products")" class="btn btn-sm btn-warning">Xem tất cả</a>
                </div>
                <div class="card-body">
                    @if (Model.LowStockProducts.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Sản phẩm</th>
                                        <th>Danh mục</th>
                                        <th>Tồn kho</th>
                                        <th>Giá</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in Model.LowStockProducts.Take(5))
                                    {
                                        <tr>
                                            <td>
                                                <a href="@Url.Action("Details", "Products", new { id = product.ProductId })">
                                                    @product.ProductName
                                                </a>
                                            </td>
                                            <td>@product.CategoryName</td>
                                            <td>
                                                <span
                                                    class="badge badge-@(product.StockQuantity == 0 ? "danger" : product.StockQuantity <= 5 ? "warning" : "success")">
                                                    @product.StockQuantity
                                                </span>
                                            </td>
                                            <td>@product.Price.ToString("C0")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Tất cả sản phẩm đều còn đủ hàng.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div class="col-lg-6 mb-4">
            <div class="card shadow">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-info">Thao tác nhanh</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-6 mb-3">
                            <a href="@Url.Action("Create", "Products")" class="btn btn-primary btn-block">
                                <i class="fas fa-plus"></i> Thêm sản phẩm
                            </a>
                        </div>
                        <div class="col-6 mb-3">
                            <a href="@Url.Action("Index", "Orders")" class="btn btn-success btn-block">
                                <i class="fas fa-shopping-cart"></i> Quản lý đơn hàng
                            </a>
                        </div>
                        <div class="col-6 mb-3">
                            <a href="@Url.Action("Index", "Users")" class="btn btn-info btn-block">
                                <i class="fas fa-users"></i> Quản lý người dùng
                            </a>
                        </div>
                        <div class="col-6 mb-3">
                            <a href="@Url.Action("Index", "Categories")" class="btn btn-warning btn-block">
                                <i class="fas fa-list"></i> Quản lý danh mục
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .border-left-primary {
        border-left: 0.25rem solid #4e73df !important;
    }

    .border-left-success {
        border-left: 0.25rem solid #1cc88a !important;
    }

    .border-left-info {
        border-left: 0.25rem solid #36b9cc !important;
    }

    .border-left-warning {
        border-left: 0.25rem solid #f6c23e !important;
    }

    .border-left-secondary {
        border-left: 0.25rem solid #858796 !important;
    }

    .border-left-dark {
        border-left: 0.25rem solid #5a5c69 !important;
    }

    .border-left-danger {
        border-left: 0.25rem solid #e74a3b !important;
    }

    .border-left-light {
        border-left: 0.25rem solid #f8f9fc !important;
    }

    .text-gray-800 {
        color: #5a5c69 !important;
    }

    .text-gray-300 {
        color: #dddfeb !important;
    }

    .card {
        transition: transform 0.2s;
    }

    .card:hover {
        transform: translateY(-2px);
    }

    .btn-block {
        display: block;
        width: 100%;
    }

    .table-sm th,
    .table-sm td {
        padding: 0.5rem;
        font-size: 0.875rem;
    }

    .badge {
        font-size: 0.75rem;
    }
</style>